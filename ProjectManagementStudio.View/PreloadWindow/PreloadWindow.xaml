<Window x:Class="ProjectManagementStudio.View.PreloadWindow.PreloadWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ProjectManagementStudio.View.PreloadWindow"
        xmlns:vm="clr-namespace:ProjectManagementStudio.ViewModel.PreloadWindow;assembly=ProjectManagementStudio.ViewModel"
        mc:Ignorable="d"
        Title="PreloadWindow" Height="200" Width="400"
        WindowStartupLocation="CenterScreen"
        d:DataContext="{d:DesignInstance vm:PreloadWindowViewModel}"
        >
    <Grid>
        <Button Content="Нажмите, чтобы продолжить" Command="{Binding ContinueCommand}"/>
    </Grid>
</Window>
