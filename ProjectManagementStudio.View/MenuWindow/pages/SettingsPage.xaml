<Page x:Class="ProjectManagementStudio.View.MenuWindow.Pages.SettingsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:ProjectManagementStudio.View.MenuWindow.Pages"
      xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
      xmlns:vm="clr-namespace:ProjectManagementStudio.ViewModel.MenuWindow;assembly=ProjectManagementStudio.ViewModel"
      xmlns:tasksts="clr-namespace:ProjectManagementStudio.Model.Enums;assembly=ProjectManagementStudio.Model"
      mc:Ignorable="d" 
      d:DesignHeight="813" d:DesignWidth="1500"
      Title="SettingsPage"
      d:DataContext="{d:DesignInstance vm:MenuWindowViewModel}"
      >

    <Border d:Background="#724D9D" Background="{DynamicResource SettingsBackground}" Height="550" Width="650" CornerRadius="25" HorizontalAlignment="Center" VerticalAlignment="Center">
        <Border.Effect>
            <DropShadowEffect Color="#000000" BlurRadius="4" ShadowDepth="4" Opacity="0.25"/>
        </Border.Effect>
        <StackPanel>
            <TextBlock Text="{DynamicResource SettingsTitle}" d:Text="Settings" FontSize="75" Foreground="#FFFFFF"
                FontFamily="Outfit" FontWeight="Normal" Margin="0,33,0,0" Width="400" TextAlignment="Center"
                HorizontalAlignment="Center"/>

            <!-- Меню выбора темы -->
            <Border Margin="0,17,0,0" d:Background="#2C1B47" Background="{DynamicResource SettingsItems}"
                Width="530" Height="240" CornerRadius="10">
                <Border.Effect>
                    <DropShadowEffect Color="#000000" BlurRadius="4" ShadowDepth="4" Opacity="0.1" Direction="270"/>
                </Border.Effect>
                
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition/>
                        <RowDefinition/>
                        <RowDefinition/>
                    </Grid.RowDefinitions>

                    <!--Фиолетовая тема-->
                    <Border HorizontalAlignment="Left" CornerRadius="10" Width="220" Height="60" Margin="20,0,0,0">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" d:Value="#2C1B47" Value="{DynamicResource ThemeButton}"/>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" d:Value="#724D9D" Value="{DynamicResource ThemeButtonHover}"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>

                        <Button Background="Transparent" BorderBrush="Transparent" 
                                Command="{Binding ChangeApplicationTheme}"
                                CommandParameter="{x:Static tasksts:Theme.Default}">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Grid>
                                        <Image Margin="5,0,0,0" Source="../../Source/DefaultTheme/purple_circle.png" Width="50" Height="50" HorizontalAlignment="Left">
                                            <Image.Effect>
                                                <DropShadowEffect Color="#000000" BlurRadius="4" ShadowDepth="2" Opacity="0.5" Direction="270"/>
                                            </Image.Effect>
                                            <Image.Style>
                                                <Style TargetType="Image">
                                                    <Style.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter Property="Opacity" Value="0.8"/>
                                                        </Trigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Image.Style>
                                        </Image>
                                        <TextBlock HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,5,0"
                                            FontFamily="Outfit" FontWeight="Normal" FontSize="20" Foreground="#FFFFFF">
                                            Theme Example 1
                                        </TextBlock>
                                    </Grid>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </Border>

                    <!--Зеленая тема-->
                    <Border Grid.Column="0" Grid.Row="1" HorizontalAlignment="Left" CornerRadius="10" Width="220" Height="60" Margin="20,0,0,0">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" d:Value="#2C1B47" Value="{DynamicResource ThemeButton}"/>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" d:Value="#724D9D" Value="{DynamicResource ThemeButtonHover}"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>

                        <Button Background="Transparent" BorderBrush="Transparent"
                                Command="{Binding ChangeApplicationTheme}"
                                CommandParameter="{x:Static tasksts:Theme.Green}">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Grid>
                                        <Image Margin="5,0,0,0" Source="../../Source/GreenTheme/green_circle.png" Width="50" Height="50" HorizontalAlignment="Left">
                                            <Image.Effect>
                                                <DropShadowEffect Color="#000000" BlurRadius="4" ShadowDepth="2" Opacity="0.5" Direction="270"/>
                                            </Image.Effect>
                                            <Image.Style>
                                                <Style TargetType="Image">
                                                    <Style.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter Property="Opacity" Value="0.8"/>
                                                        </Trigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Image.Style>
                                        </Image>
                                        <TextBlock HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,5,0"
                                            FontFamily="Outfit" FontWeight="Normal" FontSize="20" Foreground="#FFFFFF">
                                            Theme Example 2
                                        </TextBlock>
                                    </Grid>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </Border>

                    <!--Синяя тема-->
                    <Border Grid.Column="0" Grid.Row="2" HorizontalAlignment="Left" CornerRadius="10" Width="220" Height="60" Margin="20,0,0,0">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" d:Value="#2C1B47" Value="{DynamicResource ThemeButton}"/>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" d:Value="#724D9D" Value="{DynamicResource ThemeButtonHover}"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>

                        <Button Background="Transparent" BorderBrush="Transparent"
                                Command="{Binding ChangeApplicationTheme}"
                                CommandParameter="{x:Static tasksts:Theme.Blue}">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Grid>
                                        <Image Margin="5,0,0,0" Source="..\..\Source\BlueTheme\blue_circle.png" Width="50" Height="50" HorizontalAlignment="Left">
                                            <Image.Effect>
                                                <DropShadowEffect Color="#000000" BlurRadius="4" ShadowDepth="2" Opacity="0.5" Direction="270"/>
                                            </Image.Effect>
                                            <Image.Style>
                                                <Style TargetType="Image">
                                                    <Style.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter Property="Opacity" Value="0.8"/>
                                                        </Trigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Image.Style>
                                        </Image>
                                        <TextBlock HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,5,0"
                                            FontFamily="Outfit" FontWeight="Normal" FontSize="20" Foreground="#FFFFFF">
                                            Theme Example 3
                                        </TextBlock>
                                    </Grid>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </Border>

                    <!--красная тема-->
                    <Border Grid.Column="1" Grid.Row="0" HorizontalAlignment="Left" CornerRadius="10" Width="220" Height="60" Margin="20,0,0,0">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" d:Value="#2C1B47" Value="{DynamicResource ThemeButton}"/>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" d:Value="#724D9D" Value="{DynamicResource ThemeButtonHover}"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>

                        <Button Background="Transparent" BorderBrush="Transparent"
                                Command="{Binding ChangeApplicationTheme}"
                                CommandParameter="{x:Static tasksts:Theme.Red}">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Grid>
                                        <Image Margin="5,0,0,0" Source="../../Source/RedTheme/red_circle.png" Width="50" Height="50" HorizontalAlignment="Left">
                                            <Image.Effect>
                                                <DropShadowEffect Color="#000000" BlurRadius="4" ShadowDepth="2" Opacity="0.5" Direction="270"/>
                                            </Image.Effect>
                                            <Image.Style>
                                                <Style TargetType="Image">
                                                    <Style.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter Property="Opacity" Value="0.8"/>
                                                        </Trigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Image.Style>
                                        </Image>
                                        <TextBlock HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,5,0"
                                            FontFamily="Outfit" FontWeight="Normal" FontSize="20" Foreground="#FFFFFF">
                                            Theme Example 4
                                        </TextBlock>
                                    </Grid>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </Border>

                    <!--красно-синяя тема-->
                    <Border Grid.Column="1" Grid.Row="1" HorizontalAlignment="Left" CornerRadius="10" Width="220" Height="60" Margin="20,0,0,0">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" d:Value="#2C1B47" Value="{DynamicResource ThemeButton}"/>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" d:Value="#724D9D" Value="{DynamicResource ThemeButtonHover}"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>

                        <Button Background="Transparent" BorderBrush="Transparent"
                                Command="{Binding ChangeApplicationTheme}"
                                CommandParameter="{x:Static tasksts:Theme.Pink}">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Grid>
                                        <Image Margin="5,0,0,0" Source="..\..\Source\PinkTheme\pink_circle.png" Width="50" Height="50" HorizontalAlignment="Left">
                                            <Image.Effect>
                                                <DropShadowEffect Color="#000000" BlurRadius="4" ShadowDepth="2" Opacity="0.5" Direction="270"/>
                                            </Image.Effect>
                                            <Image.Style>
                                                <Style TargetType="Image">
                                                    <Style.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter Property="Opacity" Value="0.8"/>
                                                        </Trigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Image.Style>
                                        </Image>
                                        <TextBlock HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,5,0"
                                            FontFamily="Outfit" FontWeight="Normal" FontSize="20" Foreground="#FFFFFF">
                                            Theme Example 5
                                        </TextBlock>
                                    </Grid>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </Border>

                    <!--Оранжевая тема-->
                    <Border Grid.Column="1" Grid.Row="2" HorizontalAlignment="Left" CornerRadius="10" Width="220" Height="60" Margin="20,0,0,0">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" d:Value="#2C1B47" Value="{DynamicResource ThemeButton}"/>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" d:Value="#724D9D" Value="{DynamicResource ThemeButtonHover}"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>

                        <Button Background="Transparent" BorderBrush="Transparent"
                                Command="{Binding ChangeApplicationTheme}"
                                CommandParameter="{x:Static tasksts:Theme.Black}">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Grid>
                                        <Image Margin="5,0,0,0" Source="..\..\Source\BlackTheme\black_circle.png" Width="50" Height="50" HorizontalAlignment="Left">
                                            <Image.Effect>
                                                <DropShadowEffect Color="#000000" BlurRadius="4" ShadowDepth="2" Opacity="0.5" Direction="270"/>
                                            </Image.Effect>
                                            <Image.Style>
                                                <Style TargetType="Image">
                                                    <Style.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter Property="Opacity" Value="0.8"/>
                                                        </Trigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Image.Style>
                                        </Image>
                                        <TextBlock HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,5,0"
                                            FontFamily="Outfit" FontWeight="Normal" FontSize="20" Foreground="#FFFFFF">
                                            Theme Example 6
                                        </TextBlock>
                                    </Grid>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </Border>

                </Grid>
            </Border>

            <!-- Меню выбора языка -->
            <Border Margin="0,17,0,0" d:Background="#2C1B47" Background="{DynamicResource SettingsItems}"
                Width="530" Height="75" CornerRadius="10">
                <Border.Effect>
                    <DropShadowEffect Color="#000000" BlurRadius="4" ShadowDepth="4" Opacity="0.1" Direction="270"/>
                </Border.Effect>

                <Grid>
                    <!--Русский язык-->
                    <Border Height="50" Width="70" CornerRadius="10">
                        <Border.Effect>
                            <DropShadowEffect Color="#000000" BlurRadius="1" ShadowDepth="2" Opacity="0.2" Direction="320"/>
                        </Border.Effect>
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" d:Value="#724D9D" Value="{DynamicResource Button}"/>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" d:Value="#5D3576" Value="{DynamicResource SettingsButtonHover}"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <Button Background="Transparent" BorderBrush="Transparent" d:Foreground="#ffffff" Foreground="{DynamicResource TextColor}"
                                FontFamily="Outfit" FontSize="36" FontWeight="Normal"
                                Command="{Binding ChangeLocalizationCommand}" CommandParameter="ru-RU"
                                >
                            <Button.Template>
                                <ControlTemplate>
                                    <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center" Content="ru"/>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </Border>

                    <!--Английский язык-->
                    <Border Height="50" Width="70" CornerRadius="10" Margin="0,0,165,0">
                        <Border.Effect>
                            <DropShadowEffect Color="#000000" BlurRadius="1" ShadowDepth="2" Opacity="0.2" Direction="320"/>
                        </Border.Effect>
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" d:Value="#724D9D" Value="{DynamicResource Button}"/>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" d:Value="#5D3576" Value="{DynamicResource SettingsButtonHover}"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <Button Background="Transparent" BorderBrush="Transparent" d:Foreground="#ffffff" Foreground="{DynamicResource TextColor}"
                            FontFamily="Outfit" FontSize="36" FontWeight="Normal"
                                Command="{Binding ChangeLocalizationCommand}" CommandParameter="eu-US"
                                >
                            <Button.Template>
                                <ControlTemplate>
                                    <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center" Content="en"/>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </Border>

                    <!--Белорусский язык-->
                    <Border Height="50" Width="70" CornerRadius="10" Margin="165,0,0,0">
                        <Border.Effect>
                            <DropShadowEffect Color="#000000" BlurRadius="1" ShadowDepth="2" Opacity="0.2" Direction="320"/>
                        </Border.Effect>
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" d:Value="#724D9D" Value="{DynamicResource Button}"/>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" d:Value="#5D3576" Value="{DynamicResource SettingsButtonHover}"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <Button Background="Transparent" BorderBrush="Transparent" d:Foreground="#ffffff" Foreground="{DynamicResource TextColor}"
                            FontFamily="Outfit" FontSize="36" FontWeight="Normal"
                                Command="{Binding ChangeLocalizationCommand}" CommandParameter="ru-RU"
                                >
                            <Button.Template>
                                <ControlTemplate>
                                    <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center" Content="by"/>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </Border>
                </Grid>
            </Border>
        </StackPanel>
    </Border>
</Page>
