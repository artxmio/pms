                              IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                              ClickMode="Press"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center"
                              BorderThickness="0" 
                              FocusVisualStyle="{x:Null}" 
                              Width="480" Height="40">
                                        <ToggleButton.Template>
                                            <ControlTemplate TargetType="ToggleButton">
                                                <Grid>
                                                    <!-- Фон для нажатий -->
                                                    <Border Background="Transparent" CornerRadius="10" />
                                                    <!-- Значок стрелки -->
                                                    <Path Width="15" Height="8" Stroke="#361B48" StrokeThickness="3"
                                      Data="M 0 0 L 8 10 L 16 0" Stretch="Fill" 
                                      HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                                </Grid>
                                                <ControlTemplate.Triggers>
                                                    <!-- Убираем любые эффекты при наведении -->
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Background" Value="Transparent" />
                                                    </Trigger>
                                                    <!-- Убираем фон при нажатии -->
                                                    <Trigger Property="IsPressed" Value="True">
                                                        <Setter Property="Background" Value="Transparent" />
                                                    </Trigger>
                                                    <!-- Если выделен -->
                                                    <Trigger Property="IsChecked" Value="True">
                                                        <Setter Property="Background" Value="Transparent" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </ToggleButton.Template>
                                    </ToggleButton>
                                    <!-- Выпадающий список -->
                                    <Popup x:Name="Popup" IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="True"
                       Placement="Bottom" Focusable="False" Margin="0">
                                        <Border x:Name="PopupBorder" Background="#724D9D" BorderBrush="Transparent"
                            BorderThickness="0" CornerRadius="10" Width="480">
                                            <ItemsPresenter />
                                        </Border>
                                    </Popup>
                                </Grid>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="BackgroundBorder" Property="Background" Value="#5D3576"/>
                                    </Trigger>
                                    <Trigger Property="IsEnabled" Value="False">
                                        <Setter TargetName="BackgroundBorder" Property="Background" Value="#1A1230"/>
                                        <Setter Property="Foreground" Value="#666666"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </ComboBox.Template>

                        <ComboBox.Resources>
                            <!-- Стиль для элементов списка -->
                            <Style TargetType="ComboBoxItem">
                                <Setter Property="Foreground" Value="White"/>
                                <Setter Property="Background" Value="#724D9D"/>
                                <Setter Property="FontSize" Value="20"/>
                                <Setter Property="FontFamily" Value="Outfit"/>
                                <Setter Property="Padding" Value="10,5"/>
                                <Setter Property="HorizontalContentAlignment" Value="Left"/>
                                <Setter Property="BorderBrush" Value="Transparent"/>
                                <!-- Убираем синий фокус -->
                                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ComboBoxItem">
                                            <Border x:Name="Border" Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="0">
                                                <ContentPresenter Margin="15,0,0,0" VerticalAlignment="Center" 
                                 HorizontalAlignment="Left" />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <!-- Эффект при наведении мыши -->
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Border" Property="Background" Value="#5D3576" />
                                                </Trigger>
                                                <!-- Эффект при выделении -->
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="Border" Property="Background" Value="#512A6B" />
                                                    <Setter Property="Foreground" Value="White" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ComboBox.Resources>
                        <!-- Пункты выбора -->
                        <ComboBoxItem Content="Default"/>
                        <ComboBoxItem Content="Red"/>
                        <ComboBoxItem Content="Blue"/>
                        <ComboBoxItem Content="Light"/>
                    </ComboBox>
                </Grid>
            </Border>

            <!-- Меню выбора Разрешения экрана -->
            <Border Margin="0,17,0,0" Background="#271F3F" Width="530" Height="125" CornerRadius="10">
                <Border.Effect>
                    <DropShadowEffect Color="#000000" BlurRadius="4" ShadowDepth="4" Opacity="0.25"/>
                </Border.Effect>
                <Grid>
                    <TextBlock Text="Size" FontSize="30" Foreground="#FFFFFF"
                       FontFamily="Outfit" FontWeight="Normal" Margin="24,12,0,0"
                       HorizontalAlignment="Left" 
                       VerticalAlignment="Top"/>

                    <ComboBox Width="480" Height="40"
          HorizontalAlignment="Center" VerticalAlignment="Bottom"
          Background="#724D9D" Foreground="White"
          FontSize="20" FontFamily="Outfit"
          BorderBrush="Transparent"
          Padding="10,5" Margin="0,0,0,18"
          SelectedIndex="0">
                        <ComboBox.Template>
                            <ControlTemplate TargetType="ComboBox">
                                <Grid>
                                    <!-- Основной фон ComboBox -->
                                    <Border x:Name="BackgroundBorder"
                        Background="{TemplateBinding Background}"
                        CornerRadius="10"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="0" />
                                    <!-- Отображение выбранного элемента -->
                                    <ContentPresenter Margin="15,0,35,0" VerticalAlignment="Center" HorizontalAlignment="Left"
                                  Content="{TemplateBinding SelectionBoxItem}" 
                                  ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" />
                                    <!-- Стрелка -->
                                    <ToggleButton x:Name="DropDownToggle" 
                              Background="Transparent"
                              Focusable="False"
                              IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                              ClickMode="Press"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center"
                              BorderThickness="0" 
                              FocusVisualStyle="{x:Null}" 
                              Width="480" Height="40">
                                        <ToggleButton.Template>
                                            <ControlTemplate TargetType="ToggleButton">
                                                <Grid>
                                                    <!-- Фон для нажатий -->
                                                    <Border Background="Transparent" CornerRadius="10" />
                                                    <!-- Значок стрелки -->
                                                    <Path Width="15" Height="8" Stroke="#361B48" StrokeThickness="3"
                                      Data="M 0 0 L 8 10 L 16 0" Stretch="Fill" 
                                      HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                                </Grid>
                                                <ControlTemplate.Triggers>
                                                    <!-- Убираем любые эффекты при наведении -->
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Background" Value="Transparent" />
                                                    </Trigger>
                                                    <!-- Убираем фон при нажатии -->
                                                    <Trigger Property="IsPressed" Value="True">
                                                        <Setter Property="Background" Value="Transparent" />
                                                    </Trigger>
                                                    <!-- Если выделен -->
                                                    <Trigger Property="IsChecked" Value="True">
                                                        <Setter Property="Background" Value="Transparent" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </ToggleButton.Template>
                                    </ToggleButton>
                                    <!-- Выпадающий список -->
                                    <Popup x:Name="Popup" IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="True"
                       Placement="Bottom" Focusable="False" Margin="0">
                                        <Border x:Name="PopupBorder" Background="#724D9D" BorderBrush="Transparent"
                            BorderThickness="0" CornerRadius="10" Width="480">
                                            <ItemsPresenter />
                                        </Border>
                                    </Popup>
                                </Grid>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="BackgroundBorder" Property="Background" Value="#5D3576"/>
                                    </Trigger>
                                    <Trigger Property="IsEnabled" Value="False">
                                        <Setter TargetName="BackgroundBorder" Property="Background" Value="#1A1230"/>
                                        <Setter Property="Foreground" Value="#666666"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </ComboBox.Template>

                        <ComboBox.Resources>
                            <!-- Стиль для элементов списка -->
                            <Style TargetType="ComboBoxItem">
                                <Setter Property="Foreground" Value="White"/>
                                <Setter Property="Background" Value="#724D9D"/>
                                <Setter Property="FontSize" Value="20"/>
                                <Setter Property="FontFamily" Value="Outfit"/>
                                <Setter Property="Padding" Value="10,5"/>
                                <Setter Property="HorizontalContentAlignment" Value="Left"/>
                                <Setter Property="BorderBrush" Value="Transparent"/>
                                <!-- Убираем синий фокус -->
                                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ComboBoxItem">
                                            <Border x:Name="Border" Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="0">
                                                <ContentPresenter Margin="15,0,0,0" VerticalAlignment="Center" 
                                 HorizontalAlignment="Left" />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <!-- Эффект при наведении мыши -->
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Border" Property="Background" Value="#5D3576" />
                                                </Trigger>
                                                <!-- Эффект при выделении -->
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="Border" Property="Background" Value="#512A6B" />
                                                    <Setter Property="Foreground" Value="White" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ComboBox.Resources>
                        <!-- Пункты выбора -->
                        <ComboBoxItem Content="1920x1080"/>
                        <ComboBoxItem Content="800x600"/>
                        <ComboBoxItem Content="1280x1024"/>
                    </ComboBox>
                </Grid>
            </Border>
            
            <!-- Версия приложения для людей с ограниченными возможностями -->
            <Grid>
                <CheckBox Width="23" Height="23" VerticalAlignment="Top" HorizontalAlignment="Left" Margin="84,18,0,0">
                    <CheckBox.Style>
                        <Style TargetType="CheckBox">
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="Foreground" Value="#2C1B45"/>
                            <Setter Property="BorderBrush" Value="#2C1B45"/>
                            <Setter Property="BorderThickness" Value="5"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="CheckBox">
                                        <Grid>
                                            <Border x:Name="Border" 
                                    Background="{TemplateBinding Background}" 
                                    BorderBrush="{TemplateBinding BorderBrush}" 
                                    BorderThickness="{TemplateBinding BorderThickness}" 
                                    CornerRadius="2"/>
                                            <Path x:Name="CheckMark" 
                                  Data="M0,4 L4,8 L8,0" 
                                  Stroke="{TemplateBinding Foreground}" 
                                  StrokeThickness="2" 
                                  Visibility="Collapsed" 
                                  SnapsToDevicePixels="True" 
                                  HorizontalAlignment="Center" 
                                  VerticalAlignment="Center"/>
                                        </Grid>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="CheckMark" Property="Visibility" Value="Visible"/>
                                            </Trigger>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="BorderBrush" Value="#432969"/>
                                                <Setter Property="Foreground" Value="#432969"/>
                                            </Trigger>
                                            <Trigger Property="IsMouseOver" Value="False">
                                                <Setter Property="BorderBrush" Value="#2C1B45"/>
                                                <Setter Property="Foreground" Value="#2C1B45"/>
                                            </Trigger>
                                            <Trigger Property="IsFocused" Value="True">
                                                <Setter Property="Background" Value="Transparent"/>
                                                <Setter Property="BorderBrush" Value="#432969"/>
                                                <Setter Property="Foreground" Value="#432969"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </CheckBox.Style>
                </CheckBox>
                <TextBlock Width="327" Height="51" Foreground="White" FontSize="20" FontWeight="Normal" FontFamily="Outfit"
                       Text="Use the mode for people with limited opportunities"
                       VerticalAlignment="Top" HorizontalAlignment="Left" Margin="112,17,0,0"
                       TextWrapping="Wrap"/>
                <!--Всплывающая подсказка-->
                <Image Source="..\..\Source\DarkQuestionMark.png" Width="20" Height="20"
                       HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,17,182,0">
                    <Image.Style>
                        <Style TargetType="Image">
                            <Setter Property="Opacity" Value="1"/>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Opacity" Value="0.7"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Image.Style>
                    <Image.ToolTip>
                        <ToolTip Content="Accessibility mode is specially designed features and settings 
                                 that make computer applications more accessible to people with special needs.">
                            <ToolTip.Template>
                                <ControlTemplate TargetType="ToolTip">
                                    <Border Width="230" Height="204" Background="#9357A1" CornerRadius="25">
                                        <TextBlock Text="{Binding RelativeSource={RelativeSource AncestorType=ToolTip}, Path=Content}" 
                                                   FontFamily="Outfit" FontSize="20" FontWeight="Normal" 
                                                   Foreground="white" TextWrapping="Wrap"
                                                   VerticalAlignment="Center" HorizontalAlignment="Center"
                                                   TextAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </ToolTip.Template>
                        </ToolTip>
                    </Image.ToolTip>
                </Image>
            </Grid>

            <Button Width="200" Height="65" VerticalAlignment="top" HorizontalAlignment="Right" Margin="0,52,22,0">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="buttonBorder"  Width="200" Height="65" Background="#2C1B47" CornerRadius="10">
                            <Border.Effect>
                                <DropShadowEffect Color="#000000" BlurRadius="4" ShadowDepth="4" Opacity="0.25"/>
                            </Border.Effect>
                            <TextBlock Text="Apply" Foreground="White" FontSize="30"
                                       FontWeight="Normal" FontFamily="Outfit"
                                       VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="buttonBorder" Property="Background" Value="#3B2B57"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </StackPanel>
    </Border>
</Page>
