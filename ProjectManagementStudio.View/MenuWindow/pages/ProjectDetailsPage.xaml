<Page x:Class="ProjectManagementStudio.View.MenuWindow.pages.ProjectDetailsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:ProjectManagementStudio.View.MenuWindow.pages"
      xmlns:vm="clr-namespace:ProjectManagementStudio.ViewModel.MenuWindow;assembly=ProjectManagementStudio.ViewModel"
      xmlns:converters="clr-namespace:ProjectManagementStudio.View.Converters"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="ProjectDetailsPage"
      Background="White"
      d:DataContext="{d:DesignInstance vm:MenuWindowViewModel}"
      Margin="50">

    <Page.Resources>
        <converters:SprintStatusConverter x:Key="SprintStatusConverter"/>
    </Page.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="3*"/>
            <ColumnDefinition Width="1*"/>
        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition/>
        </Grid.RowDefinitions>

        <Button Content="Назад" 
                HorizontalAlignment="Left" 
                Margin="10,0,0,0" 
                Grid.Row="0" 
                VerticalAlignment="Center"
                Command="{Binding NavigateToProjectPage}" Height="40" Width="45"/>
        
        <TextBlock Grid.Row="1"
                   Grid.Column="0"
                   Grid.ColumnSpan="2"
                   HorizontalAlignment="Left" 
                   Margin="30,30,0,0" 
                   TextWrapping="Wrap" 
                   d:Text="TextBlock" 
                   Text="{Binding SelectedProject.Title}"
                   FontSize="45"
                   VerticalAlignment="Top"/>

        <TextBlock Grid.Row="2"
                   Grid.Column="0"
                   Grid.ColumnSpan="2"
                   Grid.RowSpan="1"
                   HorizontalAlignment="Left" 
                   Margin="30,0,0,0" 
                   TextWrapping="Wrap"
                   d:Text="TextBox" 
                   Text="{Binding SelectedProject.Description}"
                   VerticalAlignment="Top" 
                   FontSize="35"
                   Width="735" Height="100"/>

        <Grid Grid.Row="3"
              Grid.Column="0"
              Grid.ColumnSpan="1">

            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <GroupBox Header="Спринты" 
                      Margin="10">
                <ListBox x:Name="SprintList"
                 
                 ItemsSource="{Binding Sprints}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border BorderThickness="1" CornerRadius="5" Padding="10" Margin="5"
                    BorderBrush="Gray" Background="LightGray">
                                <StackPanel MouseLeftButtonDown="StackPanel_MouseLeftButtonDown">
                                    <TextBlock Text="{Binding StartDate, StringFormat='Дата начала: {0:dd.MM.yyyy}'}"/>
                                    <TextBlock Text="{Binding EndDate, StringFormat='Дата окончания: {0:dd.MM.yyyy}'}"/>
                                    <TextBlock Text="{Binding Status, Converter={StaticResource SprintStatusConverter}}" Foreground="DarkGreen"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </GroupBox>

            <Grid Grid.Column="1">
                <Button 
                        VerticalAlignment="Top"
                        Margin="0 10 0 0"
                        Width="100"
                        Height="30"
                        Content="Добавить спринт"
                        
                        Click="ShowPopup"/>

                <!-- Всплывающее окно -->
                <Popup x:Name="SprintPopup" StaysOpen="False" Placement="Mouse">
                    <Border BorderBrush="Black" BorderThickness="1" Background="White" Padding="10">
                        <StackPanel>
                            <TextBlock Text="Выберите дату спринта:" FontWeight="Bold"/>
                            <DatePicker SelectedDate="{Binding SelectedSprintDate}" 
                                        x:Name="DatePicker"/>
                            <Button Content="OK" 
                                    Command="{Binding CreateSprintCommand}"
                                    Click="ClosePopup"/>

                            <Popup x:Name="ErrorPopup" StaysOpen="False" Placement="Top">
                                <Border BorderBrush="Red" BorderThickness="2" Background="White" Padding="5">
                                    <TextBlock Text="Спринт не может заканчиваться в прошлом" Foreground="Red"/>
                                </Border>
                            </Popup>
                        </StackPanel>
                    </Border>
                </Popup>
            </Grid>

        </Grid>

        <GroupBox Header="Участники" 
                  Grid.Row="3"
                  Grid.Column="1"
                  Grid.ColumnSpan="1"
                  Margin="10">
            <Grid>
                <ListBox x:Name="UserList" ItemsSource="{Binding Users}"
                         SelectionChanged="UserList_SelectionChanged"
                         SelectedItem="{Binding SelectedUser}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border BorderThickness="1" CornerRadius="5" Padding="10" Margin="5"
                        BorderBrush="Gray" Background="LightGray"
                        Height="75"
                        Width="250">
                                <StackPanel>
                                    <TextBlock Text="{Binding UserName}" FontSize="14" FontWeight="SemiBold"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!-- Всплывающее окно с информацией о пользователе -->
                <Popup x:Name="UserPopup" StaysOpen="False" Placement="Mouse">
                    <Border BorderBrush="Black" BorderThickness="1" Background="White" Padding="10">
                        <StackPanel>
                            <TextBlock Text="Информация о пользователе:" FontWeight="Bold"/>
                            <TextBlock Text="{Binding SelectedUser.UserName}" FontSize="16"/>
                            <Button Content="Закрыть" Click="CloseUserPopup"/>
                        </StackPanel>
                    </Border>
                </Popup>
            </Grid>
        </GroupBox>
    </Grid>
</Page>
