<Page x:Class="ProjectManagementStudio.View.MenuWindow.pages.ProjectPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:ProjectManagementStudio.View.MenuWindow.pages"
      xmlns:vm="clr-namespace:ProjectManagementStudio.ViewModel.MenuWindow;assembly=ProjectManagementStudio.ViewModel"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="ProjectPage"
      
      d:DataContext="{d:DesignInstance vm:MenuWindowViewModel}">

    <Grid Margin="120 120">
        <TabControl>
            <TabItem Header="Мои проекты">
                <Grid  >
                    <!--Заменить на ListView-->
                    <DataGrid AutoGenerateColumns="True"
                        ItemsSource="{Binding MyProjects}"/>
                </Grid>
            </TabItem>
            <TabItem Header="Проекты">
                <Grid  >
                    <!--Заменить на ListView-->
                  <DataGrid AutoGenerateColumns="True"
                        ItemsSource="{Binding Projects}"/>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>


</Page>
 