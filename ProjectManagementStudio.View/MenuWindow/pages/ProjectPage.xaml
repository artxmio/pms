<Page x:Class="ProjectManagementStudio.View.MenuWindow.pages.ProjectPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:ProjectManagementStudio.View.MenuWindow.pages"
      xmlns:converters="clr-namespace:ProjectManagementStudio.View.Converters"
      xmlns:vm="clr-namespace:ProjectManagementStudio.ViewModel.MenuWindow;assembly=ProjectManagementStudio.ViewModel"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="ProjectPage"
      
      d:DataContext="{d:DesignInstance vm:MenuWindowViewModel}">

    <Page.Resources>
        <converters:ProjectStatusConverter x:Key="StatusConverter"/>
    </Page.Resources>

    <Grid Margin="120 120">

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1*"/>
            <ColumnDefinition Width="1*"/>
        </Grid.ColumnDefinitions>

        <StackPanel HorizontalAlignment="Center" 
                    VerticalAlignment="Top"
                    Grid.Column="0">
            <TextBlock     TextWrapping="Wrap" 
                           d:Text="TextBlock" 
                           VerticalAlignment="Center"
                           FontSize="25"
                           Background="Transparent"
                           Foreground="{DynamicResource TextColor}"
                           Text="Мои проекты"/>
            <Border CornerRadius="25"
                Background="{DynamicResource ProfileItems}">
                <ListBox ItemsSource="{Binding MyProjects}"
                         Background="Transparent"
                         BorderBrush="Transparent"
                         VirtualizingPanel.ScrollUnit="Pixel"
                         ScrollViewer.VerticalScrollBarVisibility="Hidden"
                         HorizontalAlignment="Center">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Width="700"/>
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>

                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border BorderThickness="1" CornerRadius="5" Padding="10" Margin="5"
                                    BorderBrush="Gray" Background="LightGray"
                                HorizontalAlignment="Center"
                                    MouseLeftButtonDown="Border_MouseLeftButtonDown">
                                <StackPanel>
                                    <TextBlock Text="{Binding Title}" FontSize="16" FontWeight="Bold"/>
                                    <TextBlock Text="{Binding Description}" FontSize="14" TextWrapping="Wrap"/>
                                    <StackPanel Orientation="Horizontal" Margin="5 0 0 0">
                                        <TextBlock Text="Статус: " FontWeight="SemiBold"/>
                                        <TextBlock Text="{Binding Status, Converter={StaticResource StatusConverter}}" Foreground="DarkGreen"/>
                                    </StackPanel>
                                    <TextBlock Text="{Binding StartDate, StringFormat='Дата начала: {0:dd.MM.yyyy}'}"/>
                                    <TextBlock Text="{Binding EndDate, StringFormat='Дата окончания: {0:dd.MM.yyyy}'}"/>
                                </StackPanel>
                                <Border.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="Изменить статус">
                                            <MenuItem Header="Открыть" Click="OpenProject_Click"/>
                                            <MenuItem Header="Остановить" Click="StopProject_Click"/>
                                            <MenuItem Header="Завершить" Click="CloseProject_Click"/>
                                        </MenuItem>
                                        <MenuItem Header="Открыть" Click="MenuItem_Click"/>
                                    </ContextMenu>
                                </Border.ContextMenu>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>
        </StackPanel>

        <StackPanel Grid.Column="1"
                    HorizontalAlignment="Center" 
                    VerticalAlignment="Top">

            <TextBlock     TextWrapping="Wrap" 
                           d:Text="TextBlock" 
                           VerticalAlignment="Center"
                           FontSize="25"
                           Background="Transparent"
                           Foreground="{DynamicResource TextColor}"
                           Text="Все проекты"/>
            
            <Border CornerRadius="25"
                Background="{DynamicResource ProfileItems}"
                >
                <ListBox ItemsSource="{Binding Projects}"
                 Background="Transparent"
                 BorderBrush="Transparent"
                 VirtualizingPanel.ScrollUnit="Pixel"
                 ScrollViewer.VerticalScrollBarVisibility="Hidden"
                 HorizontalAlignment="Center">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Width="700"/>
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>

                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border BorderThickness="1" CornerRadius="5" Padding="10" Margin="5"
                            BorderBrush="Gray" Background="LightGray"
                        HorizontalAlignment="Center"
                            MouseLeftButtonDown="Border_MouseLeftButtonDown">
                                <StackPanel>
                                    <TextBlock Text="{Binding Title}" FontSize="16" FontWeight="Bold"/>
                                    <TextBlock Text="{Binding Description}" FontSize="14" TextWrapping="Wrap"/>
                                    <StackPanel Orientation="Horizontal" Margin="5 0 0 0">
                                        <TextBlock Text="Статус: " FontWeight="SemiBold"/>
                                        <TextBlock Text="{Binding Status, Converter={StaticResource StatusConverter}}" Foreground="DarkGreen"/>
                                    </StackPanel>
                                    <TextBlock Text="{Binding StartDate, StringFormat='Дата начала: {0:dd.MM.yyyy}'}"/>
                                    <TextBlock Text="{Binding EndDate, StringFormat='Дата окончания: {0:dd.MM.yyyy}'}"/>
                                </StackPanel>
                                <Border.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="Изменить статус">
                                            <MenuItem Header="Открыть" Click="OpenProject_Click"/>
                                            <MenuItem Header="Остановить" Click="StopProject_Click"/>
                                            <MenuItem Header="Завершить" Click="CloseProject_Click"/>
                                        </MenuItem>
                                        <MenuItem Header="Открыть" Click="MenuItem_Click"/>
                                    </ContextMenu>
                                </Border.ContextMenu>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>
        </StackPanel>
    </Grid>
</Page>
 