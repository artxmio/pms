<Page x:Class="ProjectManagementStudio.View.MenuWindow.Pages.WelcomePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:ProjectManagementStudio.View.MenuWindow.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="813" d:DesignWidth="1500"
      Title="WelcomePage">

    <Grid Height="813" Width="1500">
        <TextBlock HorizontalAlignment="Left" VerticalAlignment="Top"
            Margin="413,193,0,0"
            Foreground="#FFFFFF" FontSize="75"
            FontFamily="Outfit" FontWeight="Normal"
            Width="573" Height="Auto"
            TextWrapping="Wrap"
            TextAlignment="Center"
            Opacity="0.5"
            d:Text="Welcome to Project Management Studio!"
            Text="{DynamicResource Welcome}">
        </TextBlock>
    </Grid>
</Page>
