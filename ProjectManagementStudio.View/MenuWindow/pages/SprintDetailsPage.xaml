<Page x:Class="ProjectManagementStudio.View.MenuWindow.pages.SprintDetailsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:ProjectManagementStudio.View.MenuWindow.pages"
      xmlns:vm="clr-namespace:ProjectManagementStudio.ViewModel.MenuWindow;assembly=ProjectManagementStudio.ViewModel"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="SprintDetailsPage"
      Background="White"
      d:DataContext="{d:DesignInstance vm:MenuWindowViewModel}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="1*"/>
        </Grid.RowDefinitions>

        <Button Content="Назад" 
                HorizontalAlignment="Left" 
                Margin="10,0,0,0" 
                Grid.Row="0" 
                VerticalAlignment="Center"
                Command="{Binding NavigateToProjectDetailsPage}" Height="40" Width="45"/>

        <TextBlock Text="{Binding SelectedSprint.StartDate}"
                   FontSize="40"
                   Grid.Row="1"/>
        <TextBlock Text="{Binding SelectedSprint.EndDate}"
                   FontSize="40"
                   Grid.Row="2"/>

        <ListBox x:Name="TaskList"
                 ItemsSource="{Binding Tasks}"
                 Grid.Row="3"
                 SelectedItem="{Binding SelectedTask}">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border BorderThickness="1" CornerRadius="5" Padding="10" Margin="5"
                    BorderBrush="Gray" Background="LightGray">
                        <StackPanel MouseLeftButtonDown="StackPanel_MouseLeftButtonDown">
                            <TextBlock Text="{Binding TaskName}" FontSize="16" FontWeight="Bold"/>
                            <TextBlock Text="{Binding TaskDescription}" TextWrapping="Wrap"/>
                            <ItemsControl ItemsSource="{Binding Tags}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Padding="5" Background="LightBlue" Margin="2">
                                            <TextBlock Text="{Binding TagName}"/>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <Popup x:Name="Tasks" IsOpen="False" Placement="MousePoint">
            <Border Background="White" BorderBrush="Gray" BorderThickness="2" Padding="10" CornerRadius="5">
                <StackPanel>
                    <TextBlock Text="Task Details" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center"/>
                    <TextBlock Text="{Binding SelectedTask.TaskName}" FontSize="16"/>
                    <TextBlock Text="{Binding SelectedTask.TaskDescription}" TextWrapping="Wrap"/>

                    <ItemsControl ItemsSource="{Binding SelectedTask.Tags}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="LightBlue" Padding="5" Margin="2">
                                    <TextBlock Text="{Binding TagName}"/>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Button Content="Close" Click="Button_Click" Margin="5"/>
                </StackPanel>
            </Border>
        </Popup>
    </Grid>
</Page>
