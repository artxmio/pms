<Page x:Class="ProjectManagementStudio.View.MenuWindow.pages.SprintDetailsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:ProjectManagementStudio.View.MenuWindow.pages"
      xmlns:vm="clr-namespace:ProjectManagementStudio.ViewModel.MenuWindow;assembly=ProjectManagementStudio.ViewModel"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="SprintDetailsPage"
      d:Background="White"
      d:DataContext="{d:DesignInstance vm:MenuWindowViewModel}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="1*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0"
                    Orientation="Horizontal">

            <Button VerticalAlignment="Center"
                HorizontalAlignment="Left"
                    Width="65" Height="65" 
                    Background="Transparent"
                    BorderBrush="Transparent"
                    Command="{Binding NavigateToProjectDetailsPage}">

                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border 
                            Background="{TemplateBinding Background}" 
                            BorderBrush="{TemplateBinding BorderBrush}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Button.Template>

                <Image Margin="0,0,0,0" 
                       Width="65" 
                       Height="65" 
                       d:Source="..\..\Source\DefaultTheme\arrow.png"
                       Source="{DynamicResource Arrow}">
                    <Image.Style>
                        <Style TargetType="Image">
                            <Setter Property="Opacity" Value="0.7"/>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Opacity" Value="1"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Image.Style>
                </Image>
            </Button>

            <TextBlock Text="{Binding SelectedSprint.StartDate}"
                   Foreground="{DynamicResource TextColor}"
                   FontSize="40"
                   Grid.Row="0"/>
        </StackPanel>


        <TextBlock Text="{Binding SelectedSprint.EndDate}"
                   Foreground="{DynamicResource TextColor}"
                   FontSize="40"
                   Margin="0 0 10 0"
                   Grid.Row="1"/>

        <Border CornerRadius="15"
                Grid.Row="2"
                        Background="{DynamicResource ProfileBackground}"
                        Margin="0 10 10 10">

            <Border.Effect>
                <DropShadowEffect Color="#000000" BlurRadius="4" ShadowDepth="4" Opacity="0.1" Direction="270"/>
            </Border.Effect>

            <ListBox x:Name="TaskList"
                     ItemsSource="{Binding Tasks}"
                     SelectedItem="{Binding SelectedTask}"
                     Background="Transparent"
                     BorderBrush="Transparent"
                     HorizontalAlignment="Center"
                     Height="650"
                     VirtualizingPanel.ScrollUnit="Pixel"
                     ScrollViewer.VerticalScrollBarVisibility="Hidden">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <VirtualizingStackPanel/>
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>

                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border BorderThickness="1" 
                                        CornerRadius="5" 
                                        Padding="10" 
                                        Width="850"
                                        Height="150"
                                        HorizontalAlignment="Center"
                                        Background="{DynamicResource LogOutButton}">
                            <StackPanel MouseLeftButtonDown="StackPanel_MouseLeftButtonDown">
                                <TextBlock Text="{Binding TaskName}"
                                                   Foreground="{DynamicResource TextColor}"
                                                   FontSize="20"/>
                                <TextBlock Text="{Binding TaskDescription}"
                                                   Foreground="{DynamicResource TextColor}"
                                                   FontSize="20"/>
                                <ItemsControl ItemsSource="{Binding Tags}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Padding="5" Background="LightBlue" Margin="2">
                                                <TextBlock Text="{Binding TagName}"/>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>

        <Popup x:Name="Tasks" IsOpen="False" Placement="MousePoint">
            <Border Background="White" BorderBrush="Gray" BorderThickness="2" Padding="10" CornerRadius="5">
                <StackPanel>
                    <TextBlock Text="Edit Task" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center"/>

                    <TextBox Text="{Binding SelectedTask.TaskName, Mode=TwoWay}" Margin="5"/>
                    <TextBox Text="{Binding SelectedTask.TaskDescription, Mode=TwoWay}" Margin="5"/>

                    <!-- Список тегов -->
                    <ListBox ItemsSource="{Binding SelectedTask.Tags}" SelectionMode="Multiple">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <CheckBox Content="{Binding TagName}" IsChecked="{Binding IsChecked, Mode=TwoWay}"/>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Button Content="Save" Command="{Binding SaveTaskCommand}" Click="Button_Click" Margin="5"/>
                        <Button Content="Cancel" Click="Button_Click" Margin="5"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Popup>


        <Popup x:Name="AddTaskPopup" IsOpen="False" Placement="Center" PopupAnimation="Fade">
            <Border Background="White" BorderBrush="Gray" BorderThickness="2" Padding="10" CornerRadius="5">
                <StackPanel>
                    <TextBlock Text="Добавить задачу" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center"/>

                    <TextBlock Text="Название:" Margin="5"/>
                    <TextBox Text="{Binding NewTask.TaskName}" Margin="5"/>
                    <TextBlock Text="Описание:" Margin="5"/>
                    <TextBox Text="{Binding NewTask.TaskDescription}" Margin="5"/>

                    <!-- Выбор тегов -->
                    <ListBox ItemsSource="{Binding Tags}" SelectionMode="Single">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <CheckBox Content="{Binding TagName}" IsChecked="{Binding IsChecked, Mode=TwoWay}"/>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Button Content="Добавить" Click="Button_Click_1" Command="{Binding CreateTaskCommand}" Margin="5"/>
                        <Button Content="Отмена" Click="Button_Click_1" Margin="5"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Popup>
        <Button 
            Margin="0 10 0 35"
            Grid.Row="3"
            Foreground="{DynamicResource TextColor}"
            Background="{DynamicResource Buttons}"
            FontFamily="outfit" FontSize="15"
            FontWeight="Normal"
            Width="200" Height="40"
            Content="Новая задача"
            Click="Button_Click_2">
            <Button.Template>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="buttonBorder" 
                        CornerRadius="10" 
                        Background="{TemplateBinding Background}">
                        <ContentPresenter HorizontalAlignment="Center" 
                VerticalAlignment="Center" ContentSource="Content" 
                TextElement.FontFamily="{TemplateBinding FontFamily}" 
                TextElement.FontSize="{TemplateBinding FontSize}" 
                TextElement.FontWeight="{TemplateBinding FontWeight}"
                TextElement.Foreground="{TemplateBinding Foreground}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="buttonBorder" Property="Background" Value="{DynamicResource ButtonsHover}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Button.Template>
        </Button>
    </Grid>
</Page>
