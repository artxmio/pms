<Page x:Class="ProjectManagementStudio.View.MenuWindow.pages.StatisticPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:ProjectManagementStudio.View.MenuWindow.pages"
      xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
      xmlns:vm="clr-namespace:ProjectManagementStudio.ViewModel.MenuWindow;assembly=ProjectManagementStudio.ViewModel"
      mc:Ignorable="d" 
      d:DesignHeight="1080" d:DesignWidth="1920"
      Title="StatisticPage"
      d:DataContext="{d:DesignInstance vm:MenuWindowViewModel}">

    <Grid Margin="50">

        <Grid.RowDefinitions>
            <RowDefinition Height="3*"/>
        </Grid.RowDefinitions>

        <Border Padding="0">

            <lvc:PieChart Grid.Row="0"
              Width="500"
              Height="500"
              Margin="0"
              Padding="0"
              FontSize="16"
              Series="{Binding StatisticPageService.ProjectSeries}"
                          BorderBrush="Black"
                          BorderThickness="1">
            </lvc:PieChart>
        </Border>


    </Grid>
</Page>
