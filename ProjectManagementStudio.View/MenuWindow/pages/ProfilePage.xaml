<Page x:Class="ProjectManagementStudio.View.MenuWindow.Pages.ProfilePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:ProjectManagementStudio.View.MenuWindow.Pages"
      xmlns:vm="clr-namespace:ProjectManagementStudio.ViewModel.MenuWindow;assembly=ProjectManagementStudio.ViewModel"
      mc:Ignorable="d"
      Title="ProfilePage" Height="813" Width="1500"
      d:DataContext="{d:DesignInstance vm:MenuWindowViewModel}"
      >

    <Page.Resources>
        <ResourceDictionary>
            <!-- Стиль для ScrollBar -->
            <Style x:Key="CustomScrollBar" TargetType="{x:Type ScrollBar}">
                <Setter Property="Width" Value="14"/>
                <Setter Property="Height" Value="160"/>
                <Setter Property="HorizontalAlignment" Value="Right"/>
                <Setter Property="VerticalAlignment" Value="Top"/>
                <Setter Property="Margin" Value="0,0,16,0"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type ScrollBar}">
                            <Grid>
                                <Border 
                                    Background="#724D9D" 
                                    CornerRadius="10" />
                                <Track Name="PART_Track" 
                                    Orientation="{TemplateBinding Orientation}">
                                    <Track.Thumb>
                                        <Thumb>
                                            <Thumb.Template>
                                                <ControlTemplate TargetType="Thumb">
                                                    <Border Height="120" Width="40" VerticalAlignment="Top" Margin="0,0,0,0"/>
                                                </ControlTemplate>
                                            </Thumb.Template>
                                        </Thumb>
                                    </Track.Thumb>
                                </Track>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="ScrollViewerStyle" TargetType="{x:Type ScrollViewer}">
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type ScrollViewer}">
                            <Grid>
                                <ScrollContentPresenter/>
                                <ScrollBar Style="{StaticResource CustomScrollBar}" 
                                    Orientation="Vertical" Visibility="Visible"/>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Page.Resources>

    <Grid>
        <Border Width="1214" Height="750" d:Background="#724D9D" Background="{DynamicResource ProfileBackground}" CornerRadius="25" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="125,20,0,0">
            <Border.Effect>
                <DropShadowEffect Color="#000000" BlurRadius="4" ShadowDepth="4" Opacity="0.25"/>
            </Border.Effect>
            <Grid>
                <!-- Данные профиля -->
                <Border CornerRadius="25"
                    d:Background="#2C1B47"
                    Background="{DynamicResource ProfileItems}"
                    HorizontalAlignment="Left" 
                    VerticalAlignment="Top" 
                    Width="733" Height="364" 
                    Margin="78,59,0,0">
                    <Border.Effect>
                        <DropShadowEffect Color="#000000" BlurRadius="4" ShadowDepth="4" Opacity="0.25"/>
                    </Border.Effect>

                    <Grid>
                        <Image Width="200" Height="200" 
                            d:Source="../../Source/DefaultTheme/ava.png"
                            Source="{DynamicResource Avatar}"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Top"
                            Margin="59,78,0,0"/>

                        <TextBlock FontSize="35" FontFamily="outfit"
                            FontWeight="Normal" 
                            Text="{Binding CurrentUser.Login, NotifyOnSourceUpdated=True, NotifyOnTargetUpdated=True}"
                            Width="221" Height="44"
                            Margin="0,134,211,0"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Top"
                            Foreground="#FFFFFF"/>

                        <TextBlock FontSize="30" FontFamily="outfit"
                            FontWeight="Normal" Text="{Binding CurrentUser.Email}"
                            Width="356" Height="38"
                            Margin="0,186,76,0"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Top"
                            Foreground="#FFFFFF"/>
                    </Grid>
                </Border>

                <!-- Опции -->
                <Border CornerRadius="25"
                    d:Background="#2C1B47"
                    Background="{DynamicResource ProfileItems}"
                    HorizontalAlignment="Right" 
                    VerticalAlignment="Top" 
                    Width="300" Height="364" 
                    Margin="0,59,76,0">
                    <Border.Effect>
                        <DropShadowEffect Color="#000000" BlurRadius="4" ShadowDepth="4" Opacity="0.25"/>
                    </Border.Effect>

                    <StackPanel Orientation="Vertical">
                        <TextBlock FontFamily="outfit" FontSize="35"
                            TextAlignment="Center"
                            Foreground="#FFFFFF" FontWeight="Normal"
                            Margin="0,31,0,0" Text="{DynamicResource Options}"
                            Width="127" Height="42"
                            HorizontalAlignment="Center"/>
                        
                        <Button Width="260" Height="39"
                            Command="{Binding ChangeLoginCommand}"
                            Margin="0,20,0,0"
                            d:Background="#724D9D"
                            Background="{DynamicResource Buttons}"
                            Content="{DynamicResource ChangeLogin}"
                            FontFamily="outfit" FontSize="25"
                            FontWeight="Normal"
                            Foreground="#ffffff">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="buttonBorder" 
                                        CornerRadius="10" 
                                        Background="{TemplateBinding Background}">
                                        <ContentPresenter HorizontalAlignment="Center" 
                                            VerticalAlignment="Center" ContentSource="Content" 
                                            TextElement.FontFamily="{TemplateBinding FontFamily}" 
                                            TextElement.FontSize="{TemplateBinding FontSize}" 
                                            TextElement.FontWeight="{TemplateBinding FontWeight}"
                                            TextElement.Foreground="{TemplateBinding Foreground}"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="buttonBorder" Property="Background" Value="#3B2B57"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <Button 
                            Command="{Binding ChangePasswordCommand}"
                            Width="260" Height="39"
                            Margin="0,20,0,0"
                            d:Background="#724D9D"
                            Background="{DynamicResource Buttons}"
                            Content="{DynamicResource ChangePassword}"
                            FontFamily="outfit" FontSize="25"
                            FontWeight="Normal"
                            Foreground="#ffffff">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="buttonBorder" 
                                        CornerRadius="10" 
                                        Background="{TemplateBinding Background}">
                                        <ContentPresenter HorizontalAlignment="Center" 
                                            VerticalAlignment="Center" ContentSource="Content" 
                                            TextElement.FontFamily="{TemplateBinding FontFamily}" 
                                            TextElement.FontSize="{TemplateBinding FontSize}" 
                                            TextElement.FontWeight="{TemplateBinding FontWeight}"
                                            TextElement.Foreground="{TemplateBinding Foreground}"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="buttonBorder" Property="Background" Value="#3B2B57"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <!-- Изменение почты -->
                        <Button 
                            Command="{Binding ChangeEmailCommand}"
                            Width="260" Height="39"
                            Margin="0,20,0,0"
                            d:Background="#724D9D"
                            Background="{DynamicResource Buttons}"
                            Content="{DynamicResource ChangeEmail}"
                            FontFamily="outfit" FontSize="25"
                            FontWeight="Normal"
                            Foreground="#ffffff">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="buttonBorder" 
                                        CornerRadius="10" 
                                        Background="{TemplateBinding Background}">
                                        <ContentPresenter HorizontalAlignment="Center" 
                                            VerticalAlignment="Center" ContentSource="Content" 
                                            TextElement.FontFamily="{TemplateBinding FontFamily}" 
                                            TextElement.FontSize="{TemplateBinding FontSize}" 
                                            TextElement.FontWeight="{TemplateBinding FontWeight}"
                                            TextElement.Foreground="{TemplateBinding Foreground}"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="buttonBorder" Property="Background" Value="#3B2B57"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </StackPanel>
                </Border>

                <!-- Список проектов -->
                <Border CornerRadius="25"
                    d:Background="#2C1B47"
                    Background="{DynamicResource ProfileItems}"
                    HorizontalAlignment="Left" 
                    VerticalAlignment="Bottom" 
                    Width="479" Height="249" 
                    Margin="79,0,0,51">
                    <Border.Effect>
                        <DropShadowEffect Color="#000000" BlurRadius="4" ShadowDepth="4" Opacity="0.25"/>
                    </Border.Effect>

                    <Grid>
                        <TextBlock Text="{DynamicResource Projects}" FontFamily="outfit" FontSize="35"
                           FontWeight="Normal" Foreground="White"
                           HorizontalAlignment="Center" VerticalAlignment="Top"
                           Width="auto" Height="44"
                           Margin="0,14,0,0"/>

                        <!-- Прокручиваемая область !!!НУЖНО ДОДЕЛАТЬ!!! -->
                        <Grid Width="479" Height="185"
                            VerticalAlignment="Bottom" HorizontalAlignment="Center">
                            
                            <ScrollViewer VerticalScrollBarVisibility="Visible" Style="{StaticResource ScrollViewerStyle}">
                                <!-- Ваш контент -->
                                <Border Width="140" Height="140"
                                    HorizontalAlignment="Left" VerticalAlignment="Top"
                                    Margin="35,0,0,0" CornerRadius="10"
                                    Background="#724D9D">
                                    
                                    <Grid>
                                        <TextBlock Text="Project-1" FontFamily="Outfit"
                                            FontSize="20" FontWeight="Normal" Foreground="White"
                                            HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>
                            </ScrollViewer>
                        </Grid>
                    </Grid>
                </Border>

                <!-- About -->
                <Border CornerRadius="25"
                    d:Background="#2C1B47"
                    Background="{DynamicResource ProfileItems}"
                    HorizontalAlignment="Left" 
                    VerticalAlignment="Bottom" 
                    Width="351" Height="249" 
                    Margin="585,0,0,51">
                    <Border.Effect>
                        <DropShadowEffect Color="#000000" BlurRadius="4" ShadowDepth="4" Opacity="0.25"/>
                    </Border.Effect>

                    <Grid>
                        <!--Конпка изменения даннах о себе-->
                        <Button Height="25" Width="25" x:Name="EditButton" Margin="0,20,20,0"
                                Background="Transparent" BorderBrush="Transparent"
                                HorizontalAlignment="Right" VerticalAlignment="Top"
                                Command="{Binding ChangeAboutTextCommand}">

                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Image x:Name="EditButton" d:Source ="../../Source/DefaultTheme/Edit_pencil.png" Source="{DynamicResource EditInfo}"></Image>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="EditButton" Property="Opacity" Value="0.7"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <TextBlock Text="{DynamicResource About}" Margin="0,14,0,0"
                            FontFamily="outfit" FontSize="35"
                            FontWeight="Normal" Foreground="White"
                            HorizontalAlignment="Center" VerticalAlignment="Top"
                            Width="auto" Height="44"/>

                        <TextBlock Text="{Binding CurrentUser.AboutText, Mode=TwoWay}"
                            FontFamily="outfit" FontSize="30" FontWeight="Normal" Foreground="White"
                            HorizontalAlignment="Center" VerticalAlignment="Top"
                            TextWrapping="Wrap" TextAlignment="Center"
                            Width="321" Height="122"
                            Margin="0,80,0,0"/>
                    </Grid>
                </Border>

                <!-- Выйти из аккаунта -->
                <Button Command="{Binding LogOutCommand}" d:Background="#2C1B47" Background="{DynamicResource ProfileItems}" Width="175" Height="60" Margin="0,0,76,51"
                    HorizontalAlignment="Right" VerticalAlignment="Bottom">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="buttonBorder" Background="{TemplateBinding Background}" CornerRadius="10">
                                <Border.Effect>
                                    <DropShadowEffect Color="Black" Direction="270" BlurRadius="4" ShadowDepth="4" Opacity="0.25"/>
                                </Border.Effect>
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="buttonBorder" Property="Background" Value="#3B2B57"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Image Width="32" Height="38" Source="..\..\Source\ExitAcc.png" Margin="5"/>
                        <TextBlock FontFamily="outfit" Width="108" Height="auto" Text="{DynamicResource LogOut}" 
                            VerticalAlignment="Center" Foreground="White" FontSize="30" FontWeight="Normal"/>
                    </StackPanel>
                </Button>
            </Grid>
        </Border>
    </Grid>
</Page>
