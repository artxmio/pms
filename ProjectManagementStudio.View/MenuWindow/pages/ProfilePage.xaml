<Page x:Class="ProjectManagementStudio.View.MenuWindow.Pages.ProfilePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:ProjectManagementStudio.View.MenuWindow.Pages"
      xmlns:vm="clr-namespace:ProjectManagementStudio.ViewModel.MenuWindow;assembly=ProjectManagementStudio.ViewModel"
      mc:Ignorable="d"
      Title="ProfilePage" Height="900" Width="1600"
      d:DataContext="{d:DesignInstance vm:MenuWindowViewModel}"
      >
    
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="10*"/>
            <ColumnDefinition Width="79*"/>
            <ColumnDefinition Width="10*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="12.56*"/>
            <RowDefinition Height="83.34*"/>
            <RowDefinition Height="4.1*"/>
        </Grid.RowDefinitions>
        
        <Border HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Background="#724D9D" CornerRadius="25" Margin="0,0,0,0" Grid.Column="1" Grid.Row="1">
            <Border.Effect>
                <DropShadowEffect Color="#000000" BlurRadius="4" ShadowDepth="4" Opacity="0.25"/>
            </Border.Effect>
            <Grid>
                <!-- Данные профиля -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="6.3*"/>
                        <ColumnDefinition Width="58.6*"/>
                        <ColumnDefinition Width="35.1*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="7.87*"/>
                        <RowDefinition Height="48.54*"/>
                        <RowDefinition Height="43.59*"/>
                    </Grid.RowDefinitions>

                    <Border CornerRadius="25"
                        Background="#2C1B47"
                        HorizontalAlignment="Stretch" 
                        VerticalAlignment="Stretch"  
                        Grid.Row="1" Grid.Column="1">
                        <Border.Effect>
                            <DropShadowEffect Color="#000000" BlurRadius="4" ShadowDepth="4" Opacity="0.25"/>
                        </Border.Effect>

                        <Grid>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="8.05*"/>
                                    <ColumnDefinition Width="27.29*"/>
                                    <ColumnDefinition Width="64.66*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="21.4*"/>
                                    <RowDefinition Height="54.94*"/>
                                    <RowDefinition Height="23.6*"/>
                                </Grid.RowDefinitions>

                                <Image HorizontalAlignment="Stretch" VerticalAlignment="Stretch" 
                                    Source="{Binding AvatarImage, Mode=OneWay}"
                                    Grid.Column="1" Grid.Row="1"/>
                            </Grid>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="41.06*"/>
                                    <ColumnDefinition Width="30.15*"/>
                                    <ColumnDefinition Width="28.78*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="36.81*"/>
                                    <RowDefinition Height="12.08*"/>
                                    <RowDefinition Height="51.11*"/>
                                </Grid.RowDefinitions>

                                <TextBlock FontSize="35" FontFamily="outfit"
                                    FontWeight="Normal"
                                    Grid.Column="1" Grid.Row="1"
                                    Text="{Binding CurrentUser.Login, NotifyOnSourceUpdated=True, NotifyOnTargetUpdated=True}"
                                    HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                    Foreground="#FFFFFF"/>
                            </Grid>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="41.06*"/>
                                    <ColumnDefinition Width="48.56*"/>
                                    <ColumnDefinition Width="10.37*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="48.9*"/>
                                    <RowDefinition Height="10.43*"/>
                                    <RowDefinition Height="40.7*"/>
                                </Grid.RowDefinitions>
                                
                                <TextBlock FontSize="30" FontFamily="outfit"
                                    Grid.Column="1" Grid.Row="1"
                                    FontWeight="Normal" Text="{Binding CurrentUser.Email}"
                                    HorizontalAlignment="Stretch"
                                    VerticalAlignment="Stretch"
                                    Foreground="#FFFFFF"/>
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>

                <!-- Опции -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="67.04*"/>
                        <ColumnDefinition Width="24*"/>
                        <ColumnDefinition Width="8.96*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="7.87*"/>
                        <RowDefinition Height="48.54*"/>
                        <RowDefinition Height="43.6*"/>
                    </Grid.RowDefinitions>
                    
                    <Border CornerRadius="25"
                        Grid.Column="1" Grid.Row="1"
                        Background="#2C1B47"
                        HorizontalAlignment="Stretch" 
                        VerticalAlignment="Stretch">
                        
                    <Border.Effect>
                        <DropShadowEffect Color="#000000" BlurRadius="4" ShadowDepth="4" Opacity="0.25"/>
                    </Border.Effect>
                    
                    
                    <Grid>  
                            <!--Текст опции-->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="30.34*"/>
                                    <ColumnDefinition Width="42.33*"/>
                                    <ColumnDefinition Width="27.33*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="8.52*"/>
                                    <RowDefinition Height="11.54*"/>
                                    <RowDefinition Height="79.94*"/>
                                </Grid.RowDefinitions>
                                
                                <TextBlock FontFamily="outfit" FontSize="35"
                                    Grid.Column="1" Grid.Row="1"
                                    TextAlignment="Center"
                                    Foreground="#FFFFFF" FontWeight="Normal"
                                    Text="{DynamicResource Options}"
                                    HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
                            </Grid>
                            
                            <!--Изменить аватарку-->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="6.75*"/>
                                    <ColumnDefinition Width="86.5*"/>
                                    <ColumnDefinition Width="6.75*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="28.57*"/>
                                    <RowDefinition Height="10.72*"/>
                                    <RowDefinition Height="60.71*"/>
                                </Grid.RowDefinitions>

                                <Button HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                    Grid.Column="1" Grid.Row="1"
                                    Command="{Binding ChangeAvatarCommand}"
                                    Margin="0,0,0,0"
                                    Background="#724D9D"
                                    Content="{DynamicResource ChangeAvatar}"
                                    FontFamily="outfit" FontSize="25"
                                    FontWeight="Normal"
                                    Foreground="#ffffff">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="buttonBorder" 
                                                CornerRadius="10" 
                                                Background="{TemplateBinding Background}">
                                                <ContentPresenter HorizontalAlignment="Center" 
                                                    VerticalAlignment="Center" ContentSource="Content" 
                                                    TextElement.FontFamily="{TemplateBinding FontFamily}" 
                                                    TextElement.FontSize="{TemplateBinding FontSize}" 
                                                    TextElement.FontWeight="{TemplateBinding FontWeight}"
                                                    TextElement.Foreground="{TemplateBinding Foreground}"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="buttonBorder" Property="Background" Value="#3B2B57"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </Grid>

                            <!--Изменить логин-->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="6.75*"/>
                                    <ColumnDefinition Width="86.5*"/>
                                    <ColumnDefinition Width="6.75*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="44.78*"/>
                                    <RowDefinition Height="10.72*"/>
                                    <RowDefinition Height="44.51*"/>
                                </Grid.RowDefinitions>

                                <Button VerticalAlignment="Stretch" HorizontalAlignment="Stretch"
                                    Command="{Binding ChangeLoginCommand}"
                                    Background="#724D9D"
                                    Content="{DynamicResource ChangeLogin}"
                                    Grid.Column="1" Grid.Row="1"
                                    FontFamily="outfit" FontSize="25"
                                    FontWeight="Normal"
                                    Foreground="#ffffff">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="buttonBorder" 
                                        CornerRadius="10" 
                                        Background="{TemplateBinding Background}">
                                                <ContentPresenter HorizontalAlignment="Center" 
                                            VerticalAlignment="Center" ContentSource="Content" 
                                            TextElement.FontFamily="{TemplateBinding FontFamily}" 
                                            TextElement.FontSize="{TemplateBinding FontSize}" 
                                            TextElement.FontWeight="{TemplateBinding FontWeight}"
                                            TextElement.Foreground="{TemplateBinding Foreground}"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="buttonBorder" Property="Background" Value="#3B2B57"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </Grid>

                            <!--Изменить пароль-->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="6.75*"/>
                                    <ColumnDefinition Width="86.5*"/>
                                    <ColumnDefinition Width="6.75*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="60.98*"/>
                                    <RowDefinition Height="10.72*"/>
                                    <RowDefinition Height="28.3*"/>
                                </Grid.RowDefinitions>

                                <Button HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                    Command="{Binding ChangePasswordCommand}"
                                    Grid.Column="1" Grid.Row="1"
                                    Background="#724D9D"
                                    Content="{DynamicResource ChangePassword}"
                                    FontFamily="outfit" FontSize="25"
                                    FontWeight="Normal"
                                    Foreground="#ffffff">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="buttonBorder" 
                                                CornerRadius="10" 
                                                Background="{TemplateBinding Background}">
                                                <ContentPresenter HorizontalAlignment="Center" 
                                                    VerticalAlignment="Center" ContentSource="Content" 
                                                    TextElement.FontFamily="{TemplateBinding FontFamily}" 
                                                    TextElement.FontSize="{TemplateBinding FontSize}" 
                                                    TextElement.FontWeight="{TemplateBinding FontWeight}"
                                                    TextElement.Foreground="{TemplateBinding Foreground}"/> 
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="buttonBorder" Property="Background" Value="#3B2B57"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </Grid>

                            <!-- Изменение почты -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="6.75*"/>
                                    <ColumnDefinition Width="86.5*"/>
                                    <ColumnDefinition Width="6.75*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="77.75*"/>
                                    <RowDefinition Height="10.72*"/>
                                    <RowDefinition Height="11.53*"/>
                                </Grid.RowDefinitions>

                                <Button HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                    Grid.Row="1" Grid.Column="1"
                                    Command="{Binding ChangeEmailCommand}"
                                    Background="#724D9D"
                                    Content="{DynamicResource ChangeEmail}"
                                    FontFamily="outfit" FontSize="25"
                                    FontWeight="Normal"
                                    Foreground="#ffffff">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="buttonBorder" 
                                                CornerRadius="10" 
                                                Background="{TemplateBinding Background}">
                                                <ContentPresenter HorizontalAlignment="Center" 
                                                    VerticalAlignment="Center" ContentSource="Content" 
                                                    TextElement.FontFamily="{TemplateBinding FontFamily}" 
                                                    TextElement.FontSize="{TemplateBinding FontSize}" 
                                                    TextElement.FontWeight="{TemplateBinding FontWeight}"
                                                    TextElement.Foreground="{TemplateBinding Foreground}"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="buttonBorder" Property="Background" Value="#3B2B57"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </Grid>
                        </Grid>
                </Border>
                </Grid>

            <!-- Список проектов -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="6.32*"/>
                        <ColumnDefinition Width="38.32*"/>
                        <ColumnDefinition Width="55.36*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="60*"/>
                        <RowDefinition Height="33.2*"/>
                        <RowDefinition Height="6.8*"/>
                    </Grid.RowDefinitions>

                    <Border CornerRadius="25"
                    Background="#2C1B47"
                    HorizontalAlignment="Stretch" 
                    VerticalAlignment="Stretch" 
                    Grid.Row="1" Grid.Column="1">
                        <Border.Effect>
                            <DropShadowEffect Color="#000000" BlurRadius="4" ShadowDepth="4" Opacity="0.25"/>
                        </Border.Effect>

                        <Grid>
                            <!--Текст проекты-->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="36.85*"/>
                                    <ColumnDefinition Width="26.3*"/>
                                    <ColumnDefinition Width="36.85*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="5.62*"/>
                                    <RowDefinition Height="17.67*"/>
                                    <RowDefinition Height="76.71*"/>
                                </Grid.RowDefinitions>

                                <TextBlock Text="{DynamicResource Projects}" FontFamily="outfit" FontSize="35"
                                   FontWeight="Normal" Foreground="White" Grid.Column="1" Grid.Row="1"
                                   HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
                            </Grid>

                            <!-- Прокручиваемая область !!!НУЖНО ДОДЕЛАТЬ!!! -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="100*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="27.3*"/>
                                    <RowDefinition Height="72.7*"/>
                                </Grid.RowDefinitions>

                                <Grid VerticalAlignment="Stretch" HorizontalAlignment="Stretch" Grid.Row="1">
                                    <ScrollViewer VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled">
                                        <StackPanel Orientation="Vertical">
                                            <ItemsControl>
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <StackPanel Orientation="Vertical" />
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>

                                                <!-- Проекты -->
                                                <WrapPanel Orientation="Horizontal" VerticalAlignment="Top">
                                                    <Border Width="150" Height="150" Margin="65,10,0,0" CornerRadius="10" Background="#724D9D">
                                                        <Grid>
                                                            <TextBlock Text="Project-1" FontFamily="Outfit" FontSize="20" FontWeight="Normal" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </Grid>
                                                    </Border>

                                                    <Border Width="150" Height="150" Margin="50,10,0,0" CornerRadius="10" Background="#724D9D">
                                                        <Grid>
                                                            <TextBlock Text="Project-2" FontFamily="Outfit" FontSize="20" FontWeight="Normal" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </Grid>
                                                    </Border>
                                                </WrapPanel>

                                                <WrapPanel Orientation="Horizontal" VerticalAlignment="Top">
                                                    <Border Width="150" Height="150" Margin="65,25,0,20" CornerRadius="10" Background="#724D9D">
                                                        <Grid>
                                                            <TextBlock Text="Project-3" FontFamily="Outfit" FontSize="20" FontWeight="Normal" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </Grid>
                                                    </Border>

                                                    <Border Width="150" Height="150" Margin="50,25,0,20" Padding="0,0,0,0" CornerRadius="10" Background="#724D9D">
                                                        <Grid>
                                                            <TextBlock Text="Project-4" FontFamily="Outfit" FontSize="20" FontWeight="Normal" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </Grid>
                                                    </Border>
                                                </WrapPanel>
                                            </ItemsControl>
                                        </StackPanel>
                                    </ScrollViewer>
                                </Grid>
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>

                <!-- About -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="46.8*"/>
                        <ColumnDefinition Width="28.08*"/>
                        <ColumnDefinition Width="25.12*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="60*"/>
                        <RowDefinition Height="33.2*"/>
                        <RowDefinition Height="6.8*"/>
                    </Grid.RowDefinitions>

                    <Border CornerRadius="25"
                        Grid.Column="1" Grid.Row="1"
                        Background="#2C1B47"
                        HorizontalAlignment="Stretch" 
                        VerticalAlignment="Stretch">
                        <Border.Effect>
                            <DropShadowEffect Color="#000000" BlurRadius="4" ShadowDepth="4" Opacity="0.25"/>
                        </Border.Effect>

                        <Grid>
                            <!--Конпка изменения даннах о себе-->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="87.19*"/>
                                    <ColumnDefinition Width="7.12*"/>
                                    <ColumnDefinition Width="5.69*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="8.03*"/>
                                    <RowDefinition Height="10.04*"/>
                                    <RowDefinition Height="81.93*"/>
                                </Grid.RowDefinitions>

                                <Button x:Name="EditButton" Grid.Row="1" Grid.Column="1"
                                    Background="Transparent" BorderBrush="Transparent"
                                    HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                    Command="{Binding ChangeAboutTextCommand}">

                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Image x:Name="EditButton" Source ="..\..\Source\Edit_pencil.png"></Image>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="EditButton" Property="Opacity" Value="0.7"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </Grid>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="36.47*"/>
                                    <ColumnDefinition Width="27.35*"/>
                                    <ColumnDefinition Width="36.18*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="5.62*"/>
                                    <RowDefinition Height="17.67*"/>
                                    <RowDefinition Height="76.71*"/>
                                </Grid.RowDefinitions>

                                <TextBlock Text="{DynamicResource About}"
                                    Grid.Row="1" Grid.Column="1"
                                    FontFamily="outfit" FontSize="35"
                                    FontWeight="Normal" Foreground="White"
                                    HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
                            </Grid>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="4.27*"/>
                                    <ColumnDefinition Width="91.71*"/>
                                    <ColumnDefinition Width="4.27*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="32.13*"/>
                                    <RowDefinition Height="48.99*"/>
                                    <RowDefinition Height="18.88*"/>
                                </Grid.RowDefinitions>

                                <TextBlock Text="{Binding CurrentUser.AboutText, Mode=TwoWay}"
                                    FontFamily="outfit" FontSize="30" FontWeight="Normal" Foreground="White"
                                    HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                    TextWrapping="Wrap" TextAlignment="Center"
                                    Grid.Row="1" Grid.Column="1"/>
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>

                <!-- Выйти из аккаунта -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="77.04*"/>
                        <ColumnDefinition Width="14*"/>
                        <ColumnDefinition Width="8.96*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="85.1*"/>
                        <RowDefinition Height="8*"/>
                        <RowDefinition Height="6.9*"/>
                    </Grid.RowDefinitions>

                    <Button Command="{Binding LogOutCommand}" Background="#2C1B47" Grid.Row="1" Grid.Column="1"
                        HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="buttonBorder" Background="{TemplateBinding Background}" CornerRadius="10">
                                    <Border.Effect>
                                        <DropShadowEffect Color="Black" Direction="270" BlurRadius="4" ShadowDepth="4" Opacity="0.25"/>
                                    </Border.Effect>
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="buttonBorder" Property="Background" Value="#3B2B57"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Image Width="32" Height="38" Source="..\..\Source\ExitAcc.png" Margin="5"/>
                            <TextBlock FontFamily="outfit" Width="108" Height="auto" Text="{DynamicResource LogOut}" 
                                VerticalAlignment="Center" Foreground="White" FontSize="30" FontWeight="Normal"/>
                        </StackPanel>
                    </Button>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Page>
