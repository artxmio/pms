<Page x:Class="ProjectManagementStudio.View.MenuWindow.Pages.ProfilePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:ProjectManagementStudio.View.MenuWindow.Pages"
      xmlns:vm="clr-namespace:ProjectManagementStudio.ViewModel.MenuWindow;assembly=ProjectManagementStudio.ViewModel"
      mc:Ignorable="d"
      Title="ProfilePage" Height="900" Width="1600"
      d:DataContext="{d:DesignInstance vm:MenuWindowViewModel}"
      >

    <Grid>
        <Border Width="1250" Height="750" Background="#724D9D" CornerRadius="25" Margin="0,0,20,0">
            <Border.Effect>
                <DropShadowEffect Color="#000000" BlurRadius="4" ShadowDepth="4" Opacity="0.25"/>
            </Border.Effect>
            <Grid>
                <!-- Данные профиля -->
                <Border CornerRadius="25"
                    Background="#2C1B47"
                    HorizontalAlignment="Left" 
                    VerticalAlignment="Top" 
                    Width="733" Height="364" 
                    Margin="78,59,0,0">
                    <Border.Effect>
                        <DropShadowEffect Color="#000000" BlurRadius="4" ShadowDepth="4" Opacity="0.25"/>
                    </Border.Effect>

                    <Grid>
                        <Image Width="200" Height="200" 
                    Source="{Binding AvatarImage, Mode=OneWay}"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top"
                    Margin="59,78,0,0"/>

                        <!-- СДЕЛАТЬ КОГДА СЕРВАК! -->
                        <TextBlock FontSize="35" FontFamily="outfit"
                               FontWeight="Normal" Text="{Binding CurrentUser.Login}"
                               Width="221" Height="44"
                               Margin="0,134,211,0"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Top"
                               Foreground="#FFFFFF"/>

                        <!-- СДЕЛАТЬ КОГДА СЕРВАК! -->
                        <TextBlock FontSize="30" FontFamily="outfit"
                               FontWeight="Normal" Text="{Binding CurrentUser.Email}"
                               Width="356" Height="38"
                               Margin="0,186,76,0"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Top"
                               Foreground="#FFFFFF"/>
                    </Grid>
                </Border>

                <!-- Опции -->
                <Border CornerRadius="25"
                Background="#2C1B47"
                HorizontalAlignment="Right" 
                VerticalAlignment="Top" 
                Width="300" Height="364" 
                Margin="0,59,112,0">
                    <Border.Effect>
                        <DropShadowEffect Color="#000000" BlurRadius="4" ShadowDepth="4" Opacity="0.25"/>
                    </Border.Effect>

                    <StackPanel Orientation="Vertical">
                        <TextBlock FontFamily="outfit" FontSize="35" 
                               Foreground="#FFFFFF" FontWeight="Normal"
                               Margin="0,31,0,0" Text="Options"
                               Width="127" Height="42"
                               HorizontalAlignment="Center"/>

                        <!-- СДЕЛАТЬ КОГДА СЕРВАК! -->
                        <Button Width="260" Height="39"
                                Command="{Binding ChangeAvatarCommand}"
                            Margin="0,31,0,0"
                            Background="#724D9D"
                            Content="Change avatar"
                            FontFamily="outfit" FontSize="25"
                            FontWeight="Normal"
                            Foreground="#ffffff">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="buttonBorder" 
                                    CornerRadius="10" 
                                    Background="{TemplateBinding Background}">
                                        <ContentPresenter 
                                    HorizontalAlignment="Center" 
                                    VerticalAlignment="Center"
                                    ContentSource="Content" 
                                    TextElement.FontFamily="{TemplateBinding FontFamily}" 
                                    TextElement.FontSize="{TemplateBinding FontSize}" 
                                    TextElement.FontWeight="{TemplateBinding FontWeight}"
                                    TextElement.Foreground="{TemplateBinding Foreground}"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="buttonBorder" Property="Background" Value="#3B2B57"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <!-- СДЕЛАТЬ КОГДА СЕРВАК! -->
                        <Button Width="260" Height="39"
                                Command="{Binding ChangeLoginCommand}"
                            Margin="0,20,0,0"
                            Background="#724D9D"
                            Content="Change login"
                            FontFamily="outfit" FontSize="25"
                            FontWeight="Normal"
                            Foreground="#ffffff">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="buttonBorder" 
                                    CornerRadius="10" 
                                    Background="{TemplateBinding Background}">
                                        <ContentPresenter 
                                    HorizontalAlignment="Center" 
                                    VerticalAlignment="Center"
                                    ContentSource="Content" 
                                    TextElement.FontFamily="{TemplateBinding FontFamily}" 
                                    TextElement.FontSize="{TemplateBinding FontSize}" 
                                    TextElement.FontWeight="{TemplateBinding FontWeight}"
                                    TextElement.Foreground="{TemplateBinding Foreground}"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="buttonBorder" Property="Background" Value="#3B2B57"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <!-- СДЕЛАТЬ КОГДА СЕРВАК! -->
                        <Button 
                            Command="{Binding ChangePasswordCommand}"
                            Width="260" Height="39"
                            Margin="0,20,0,0"
                            Background="#724D9D"
                            Content="Change password"
                            FontFamily="outfit" FontSize="25"
                            FontWeight="Normal"
                            Foreground="#ffffff">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="buttonBorder" 
                                    CornerRadius="10" 
                                    Background="{TemplateBinding Background}">
                                        <ContentPresenter 
                                        HorizontalAlignment="Center" 
                                        VerticalAlignment="Center"
                                        ContentSource="Content" 
                                        TextElement.FontFamily="{TemplateBinding FontFamily}" 
                                        TextElement.FontSize="{TemplateBinding FontSize}" 
                                        TextElement.FontWeight="{TemplateBinding FontWeight}"
                                        TextElement.Foreground="{TemplateBinding Foreground}"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="buttonBorder" Property="Background" Value="#3B2B57"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <!-- СДЕЛАТЬ КОГДА СЕРВАК! -->
                        <Button 
                            Command="{Binding ChangeEmailCommand}"
                            Width="260" Height="39"
                            Margin="0,20,0,0"
                            Background="#724D9D"
                            Content="Change email"
                            FontFamily="outfit" FontSize="25"
                            FontWeight="Normal"
                            Foreground="#ffffff">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="buttonBorder" 
                                    CornerRadius="10" 
                                    Background="{TemplateBinding Background}">
                                        <ContentPresenter 
                                        HorizontalAlignment="Center" 
                                        VerticalAlignment="Center"
                                        ContentSource="Content" 
                                        TextElement.FontFamily="{TemplateBinding FontFamily}" 
                                        TextElement.FontSize="{TemplateBinding FontSize}" 
                                        TextElement.FontWeight="{TemplateBinding FontWeight}"
                                        TextElement.Foreground="{TemplateBinding Foreground}"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="buttonBorder" Property="Background" Value="#3B2B57"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </StackPanel>
                </Border>

                <!-- Список проектов -->
                <Border CornerRadius="25"
                    Background="#2C1B47"
                    HorizontalAlignment="Left" 
                    VerticalAlignment="Bottom" 
                    Width="479" Height="249" 
                    Margin="79,0,0,51">
                    <Border.Effect>
                        <DropShadowEffect Color="#000000" BlurRadius="4" ShadowDepth="4" Opacity="0.25"/>
                    </Border.Effect>

                    <Grid>
                        <TextBlock Text="Projects"
                       FontFamily="outfit"
                       FontSize="35"
                       Width="126" Height="44"
                       FontWeight="Normal"
                       Foreground="White"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Top"
                       Margin="0,14,0,0"/>

                        <!-- Прокручиваемая область !!!НУЖНО СОЗДАТЬ КОГДА БУДЕТ СЕРВАК!!!-->

                    </Grid>
                </Border>

                <!-- About -->
                <Border CornerRadius="25"
                    Background="#2C1B47"
                    HorizontalAlignment="Left" 
                    VerticalAlignment="Bottom" 
                    Width="351" Height="249" 
                    Margin="585,0,0,51">
                    <Border.Effect>
                        <DropShadowEffect Color="#000000" BlurRadius="4" ShadowDepth="4" Opacity="0.25"/>
                    </Border.Effect>

                    <Grid>
                        <TextBlock Text="About"
                        FontFamily="outfit"
                        FontSize="35"
                        Width="96" Height="44"
                        FontWeight="Normal"
                        Foreground="White"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Top"
                        Margin="0,14,0,0"/>

                        <TextBlock Text="Pellentesque commodo ipsum orci, a dignissim metus convallis ut."
                               FontFamily="outfit"
                               FontSize="30"
                               TextWrapping="Wrap"
                               TextAlignment="Center"
                               Width="321" Height="122"
                               FontWeight="Normal"
                               Foreground="White"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Top"
                               Margin="0,91,0,0"/>
                    </Grid>
                </Border>

                <!-- Оценка -->
                <Border CornerRadius="25"
                    Background="#2C1B47"
                    HorizontalAlignment="Right" 
                    VerticalAlignment="Bottom" 
                    Width="175" Height="162" 
                    Margin="0,0,112,138">
                    <Border.Effect>
                        <DropShadowEffect Color="#000000" BlurRadius="4" ShadowDepth="4" Opacity="0.25"/>
                    </Border.Effect>

                    <Grid>
                        <Image Source="..\..\Source\QuestionMark.png"
                               Height="20" Width="20"
                               VerticalAlignment="Top"
                               HorizontalAlignment="Right"
                               Margin="0,14,14,0">
                            <Image.Style>
                                <Style TargetType="Image">
                                    <Setter Property="Opacity" Value="1"/>
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Opacity" Value="0.7"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Image.Style>
                            <Image.ToolTip>
                                <ToolTip Content="The user's rating is formed from the ratings 
                                         used by the team leader to evaluate the employee.">
                                    <ToolTip.Template>
                                        <ControlTemplate TargetType="ToolTip">
                                            <Border Width="230" Height="180" Background="#9357A1" CornerRadius="25">
                                                <TextBlock Text="{TemplateBinding Content}" 
                                                           FontFamily="Outfit" FontSize="20" FontWeight="Normal" 
                                                           Foreground="white" TextWrapping="Wrap"
                                                           VerticalAlignment="Center" HorizontalAlignment="Center"
                                                           TextAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </ToolTip.Template>
                                </ToolTip>
                            </Image.ToolTip>
                        </Image>
                        <TextBlock Text="Rate"
                               FontFamily="outfit"
                               FontSize="35"
                               Width="73" Height="44"
                               FontWeight="Normal"
                               Foreground="White"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Top"
                               Margin="0,14,0,0"/>

                        <Image Source="..\..\Source\Star.png"
                           Height="45" Width="45"
                           VerticalAlignment="Bottom"
                           HorizontalAlignment="Right"
                           Margin="0,0,29,42"/>


                        <TextBlock Text="5.0"
                               FontFamily="outfit"
                               FontSize="35"
                               Width="73" Height="44"
                               FontWeight="Normal"
                               Foreground="White"
                               HorizontalAlignment="Left"
                               VerticalAlignment="Bottom"
                               Margin="40,0,0,39"/>
                    </Grid>
                </Border>

                <!-- Выйти из аккаунта -->
                <Button Command="{Binding LogOutCommand}" Background="#2C1B47" Width="175" Height="60" Margin="0,0,112,51"
                    HorizontalAlignment="Right" VerticalAlignment="Bottom">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="buttonBorder" Background="{TemplateBinding Background}" CornerRadius="10">
                                <Border.Effect>
                                    <DropShadowEffect Color="Black" Direction="270" BlurRadius="4" ShadowDepth="4" Opacity="0.25"/>
                                </Border.Effect>
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="buttonBorder" Property="Background" Value="#3B2B57"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Image Width="32" Height="38" Source="..\..\Source\ExitAcc.png" Margin="5"/>
                        <TextBlock FontFamily="outfit" 
                               Width="108" Height="40" 
                               Text="Log out" 
                               VerticalAlignment="Center"
                               Foreground="White" FontSize="30"
                               FontWeight="Normal"/>
                    </StackPanel>
                </Button>
            </Grid>
        </Border>
    </Grid>
</Page>
