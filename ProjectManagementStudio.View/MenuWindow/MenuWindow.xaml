<Window x:Class="ProjectManagementStudio.View.MenuWindow.MenuWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ProjectManagementStudio.View.MenuWindow"
        mc:Ignorable="d"
        Title="MenuWindow" Height="900" Width="1600"
        ResizeMode="NoResize"
        WindowStyle="None"
        WindowState="Maximized"
        >
    <Window.Resources>
        <Style x:Key="CloseButton" TargetType="{x:Type Button}">
            <Setter Property="Background" Value="#3D5754"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="Red"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>
    
    <Window.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#221B37" Offset="0.36" />
            <GradientStop Color="#352469" Offset="1" />
        </LinearGradientBrush>
    </Window.Background>

    <Grid>
        <Frame x:Name="WelcomeFrame" NavigationUIVisibility="Hidden" Navigated="WelcomeFrame_Navigated"/>
        
        <!-- Верхнее меню -->
        <StackPanel Orientation="Horizontal" VerticalAlignment="Top" HorizontalAlignment="Right" Width="1500" Height="87">
            <StackPanel.Style>
                <Style TargetType="StackPanel">
                    <Setter Property="Background">
                        <Setter.Value>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="#2C1B47" Offset="0" />
                                <GradientStop Color="#3C2463" Offset="1" />
                            </LinearGradientBrush>
                        </Setter.Value>
                    </Setter>
                </Style>
            </StackPanel.Style>

            <!-- Кнопка Профиля-->
            <Button
            BorderBrush="Transparent"
            Margin="1097,10,0,0" 
            Width="65" Height="65" 
            HorizontalAlignment="Right" VerticalAlignment="Top" 
            Background="Transparent">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border 
                            Background="{TemplateBinding Background}" 
                            BorderBrush="{TemplateBinding BorderBrush}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Button.Template>
                <Image Height="60" Width="60" Source="..\Source\user.png">
                    <Image.Style>
                        <Style TargetType="Image">
                            <Setter Property="Opacity" Value="0.7"/>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Opacity" Value="1"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Image.Style>
                </Image>
            </Button>

            <!-- Логин пользователя -->
            <TextBlock Margin="12,0,0,0" 
                       Height="38" Width="190">
                
            </TextBlock>
            
            <Button Click="CloseButton_Click"
            BorderBrush="Transparent"
            Margin="86,20,20,0" 
            Width="30" Height="30" 
            VerticalAlignment="Top" 
            HorizontalAlignment="Right" 
            Background="Transparent" 
            Style="{StaticResource ResourceKey=CloseButton}">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border 
                            Background="{TemplateBinding Background}" 
                            BorderBrush="{TemplateBinding BorderBrush}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Button.Template>
                <Image x:Name="close" Source="..\Source\close_icon.png">
                    <Image.Style>
                        <Style TargetType="Image">
                            <Setter Property="Opacity" Value="0.5"/>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Opacity" Value="1"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Image.Style>
                </Image>
            </Button>
        </StackPanel>

        <!-- Боковое меню -->
        <StackPanel Background="#2C1B47" VerticalAlignment="Center" HorizontalAlignment="Left" Width="100" Height="900">
            <!-- Кнопка дом -->
            <Button
             BorderBrush="Transparent"
            Margin="0,18,0,0" 
            Width="65" Height="65" 
            VerticalAlignment="Top"  
            Background="Transparent">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border 
                        Background="{TemplateBinding Background}" 
                        BorderBrush="{TemplateBinding BorderBrush}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Button.Template>
                <Image Margin="0,0,0,0" Height="60" Width="60" Source="..\Source\home.png">
                <Image.Style>
                    <Style TargetType="Image">
                        <Setter Property="Opacity" Value="0.7"/>
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Opacity" Value="1"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Image.Style>
                </Image>
            </Button>
            <!-- Кнопка Ползователь -->
            <Button
            BorderBrush="Transparent"
            Margin="0,28,0,0" 
            Width="65" Height="65" 
            VerticalAlignment="Top"  
            Background="Transparent">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border 
                            Background="{TemplateBinding Background}" 
                            BorderBrush="{TemplateBinding BorderBrush}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Button.Template>
                <Image Margin="0,0,0,0" Height="60" Width="60" Source="..\Source\user.png">
                    <Image.Style>
                        <Style TargetType="Image">
                            <Setter Property="Opacity" Value="0.7"/>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Opacity" Value="1"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Image.Style>
                </Image>
            </Button>
            <!-- Кнопка Файл -->
            <Button
            BorderBrush="Transparent"
            Margin="0,28,0,0" 
            Width="65" Height="65" 
            VerticalAlignment="Top"  
            Background="Transparent">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border 
                            Background="{TemplateBinding Background}" 
                            BorderBrush="{TemplateBinding BorderBrush}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Button.Template>
                <Image Margin="0,0,0,0" Height="60" Width="60" Source="..\Source\file.png">
                    <Image.Style>
                        <Style TargetType="Image">
                            <Setter Property="Opacity" Value="0.7"/>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Opacity" Value="1"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Image.Style>
                </Image>
            </Button>

            <!-- Кнопка настройки -->
            <Button
            BorderBrush="Transparent"
            Margin="0,571,0,0" 
            Width="54" Height="54" 
            VerticalAlignment="Bottom"  
            Background="Transparent">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border 
                            Background="{TemplateBinding Background}" 
                            BorderBrush="{TemplateBinding BorderBrush}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Button.Template>
                <Image Margin="0,0,0,0" Height="50" Width="50" Source="..\Source\settings.png">
                    <Image.Style>
                        <Style TargetType="Image">
                            <Setter Property="Opacity" Value="0.7"/>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Opacity" Value="1"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Image.Style>
                </Image>
            </Button>
        </StackPanel>

        <!-- Кнопка добавить проект-->
        <Button
        BorderBrush="Transparent"
        Margin="0,0,24,24"
        Width="54" Height="54" 
        HorizontalAlignment="Right" VerticalAlignment="Bottom" 
        Background="Transparent">
            <Button.Template>
                <ControlTemplate TargetType="Button">
                    <Border 
                        Background="{TemplateBinding Background}" 
                        BorderBrush="{TemplateBinding BorderBrush}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Button.Template>
            <Image Height="50" Width="50" Source="..\Source\plus.png">
                <Image.Style>
                    <Style TargetType="Image">
                        <Setter Property="Opacity" Value="0.7"/>
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Opacity" Value="1"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Image.Style>
            </Image>
        </Button>
    </Grid>
</Window>
