<Window x:Class="ProjectManagementStudio.View.MenuWindow.MenuWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ProjectManagementStudio.View.MenuWindow"
        xmlns:vm="clr-namespace:ProjectManagementStudio.ViewModel.MenuWindow;assembly=ProjectManagementStudio.ViewModel"
        mc:Ignorable="d"
        Title="MenuWindow" Height="900" Width="1600"
        ResizeMode="NoResize"
        WindowStyle="None"
        WindowState="Maximized"
        RenderOptions.BitmapScalingMode="HighQuality"
        
        d:DataContext="{d:DesignInstance vm:MenuWindowViewModel}">

    <Window.Resources>
        <Style x:Key="CloseButton" TargetType="{x:Type Button}">
            <Setter Property="Background" Value="#3D5754"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="Red"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Window.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#221B37" Offset="0" />
            <GradientStop Color="#352469" Offset="1" />
        </LinearGradientBrush>
    </Window.Background>

    <Grid>
        <Frame Content="{Binding ActivePage}" NavigationUIVisibility="Hidden"/>

        <!-- Верхнее меню -->
        <Grid Height="87" VerticalAlignment="Top" HorizontalAlignment="Stretch" Margin="100,0,0,0">
            <Grid.Background>
                <LinearGradientBrush StartPoint="0,5" EndPoint="1,0">
                    <GradientStop Color="#2C1B47" Offset="0.2" />
                    <GradientStop Color="#3C2463" Offset="1" />
                </LinearGradientBrush>
            </Grid.Background>

            <!-- Определение столбцов и строк для верхнего меню -->
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <!-- Основное пространство -->
                <ColumnDefinition Width="Auto" />
                <!-- Кнопка профиля -->
                <ColumnDefinition Width="Auto" />
                <!-- Логин пользователя -->
                <ColumnDefinition Width="Auto" />
                <!-- Кнопка закрытия -->
            </Grid.ColumnDefinitions>

            <!-- Кнопка Профиля -->
            <Button Grid.Column="1"
                    Command="{Binding NavigateToProfilePage}"
            BorderBrush="Transparent"
            Width="65" Height="65" 
            HorizontalAlignment="Left" VerticalAlignment="Center" 
            Background="Transparent">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Button.Template>
                <Image Height="60" Width="60" Source="{Binding AvatarImage, Mode=OneWay}">
                    <Image.Style>
                        <Style TargetType="Image">
                            <Setter Property="Opacity" Value="0.7"/>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Opacity" Value="1"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Image.Style>
                </Image>
            </Button>

            <!-- Логин пользователя -->
            <TextBlock FontSize="30" 
                       FontFamily="outfit" 
                       FontWeight="Normal" 
                       Text="{Binding CurrentUser.Login}"
                       Foreground="AliceBlue" Grid.Column="2" 
                       HorizontalAlignment="Left" 
                       VerticalAlignment="Center" 
                       Margin="10,0,86,0" 
                       Height="38" 
                       Width="190"/>

            <!-- Кнопка закрытия -->
            <Button Grid.Column="3"
                    Command="{Binding CloseCommand}"
            Width="30" Height="30" 
            Background="Transparent"
            HorizontalAlignment="Right"
            VerticalAlignment="Top"
            Margin="0,20,20,0"
            Style="{StaticResource ResourceKey=CloseButton}">
                <Image x:Name="close" Source="..\Source\Close_icon.png">
                    <Image.Style>
                        <Style TargetType="{x:Type Image}">
                            <Setter Property="Opacity" Value="0.5" />
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Opacity" Value="1" />
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Image.Style>
                </Image>
            </Button>
        </Grid>

        <!-- Боковое меню -->
        <Grid Background="#2C1B47" Width="100" HorizontalAlignment="Left" VerticalAlignment="Stretch">
            <Button
                Command="{Binding NavigateToWelcomePage}"
            BorderBrush="Transparent"
            Margin="0,18,0,0" 
            Width="65" Height="65" 
            VerticalAlignment="Top"
            HorizontalAlignment="Center"
            Background="Transparent">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border 
                    Background="{TemplateBinding Background}" 
                    BorderBrush="{TemplateBinding BorderBrush}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Button.Template>
                <Image Margin="0,0,0,0" Height="60" Width="60" Source="..\Source\home.png">
                    <Image.Style>
                        <Style TargetType="Image">
                            <Setter Property="Opacity" Value="0.7"/>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Opacity" Value="1"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Image.Style>
                </Image>
            </Button>

            <!-- Кнопка Ползователь -->
            <Button
                Command="{Binding NavigateToProfilePage}"
            BorderBrush="Transparent"
            Margin="0,108,0,0" 
            Width="65" Height="65" 
            VerticalAlignment="Top"
            HorizontalAlignment="Center"
            Background="Transparent">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border 
                        Background="{TemplateBinding Background}" 
                        BorderBrush="{TemplateBinding BorderBrush}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Button.Template>
                <Image Margin="0,0,0,0" Height="60" Width="60" Source="..\Source\user.png">
                    <Image.Style>
                        <Style TargetType="Image">
                            <Setter Property="Opacity" Value="0.7"/>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Opacity" Value="1"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Image.Style>
                </Image>
            </Button>

            <!-- Кнопка Файл -->
            <Button
            BorderBrush="Transparent"
            Margin="0,198,0,0" 
            Width="65" Height="65" 
            VerticalAlignment="Top"
            HorizontalAlignment="Center"
            Background="Transparent">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border 
                        Background="{TemplateBinding Background}" 
                        BorderBrush="{TemplateBinding BorderBrush}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Button.Template>
                <Image Margin="0,0,0,0" Height="60" Width="60" Source="..\Source\file.png">
                    <Image.Style>
                        <Style TargetType="Image">
                            <Setter Property="Opacity" Value="0.7"/>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Opacity" Value="1"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Image.Style>
                </Image>
            </Button>

            <!-- Кнопка настройки -->
            <Button
            Command="{Binding NavigateToSettingsPage}"
            BorderBrush="Transparent"
            Margin="0,0,0,21" 
            Width="54" Height="54" 
            VerticalAlignment="Bottom"
            HorizontalAlignment="Center"
            Background="Transparent">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border 
                        Background="{TemplateBinding Background}" 
                        BorderBrush="{TemplateBinding BorderBrush}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Button.Template>
                <Image Margin="0,0,0,0" Height="50" Width="50" Source="..\Source\settings.png">
                    <Image.Style>
                        <Style TargetType="Image">
                            <Setter Property="Opacity" Value="0.7"/>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Opacity" Value="1"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Image.Style>
                </Image>
            </Button>
        </Grid>

        <!-- Кнопка добавить проект-->
        <Button
        BorderBrush="Transparent"
        Margin="0,0,24,24"
        Width="54" Height="54" 
        HorizontalAlignment="Right" VerticalAlignment="Bottom" 
        Background="Transparent">
            <Button.Template>
                <ControlTemplate TargetType="Button">
                    <Border 
                    Background="{TemplateBinding Background}" 
                    BorderBrush="{TemplateBinding BorderBrush}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Button.Template>
            <Image Height="50" Width="50" Source="..\Source\plus.png">
                <Image.Style>
                    <Style TargetType="Image">
                        <Setter Property="Opacity" Value="0.7"/>
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Opacity" Value="1"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Image.Style>
            </Image>
        </Button>
    </Grid>
</Window>
