<Window x:Class="ProjectManagementStudio.View.MenuWindow.MenuWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ProjectManagementStudio.View.MenuWindow"
        xmlns:vm="clr-namespace:ProjectManagementStudio.ViewModel.MenuWindow;assembly=ProjectManagementStudio.ViewModel"
        mc:Ignorable="d"
        Title="MenuWindow" 
        Left="0" Top="0"
        
        Height="{Binding Heigth, Mode=TwoWay}" 
        Width="{Binding Width, Mode=TwoWay}"
        
        MinHeight="400"
        MinWidth="500"
        
        AllowsTransparency="True"
        ResizeMode="CanResize"
        
        WindowStyle="None"
        WindowStartupLocation="Manual"
        RenderOptions.BitmapScalingMode="HighQuality"
        d:DataContext="{d:DesignInstance vm:MenuWindowViewModel}"
        d:Width="1600"
        d:Height="900">

    <Window.Resources>
        <Style x:Key="CloseButton" TargetType="{x:Type Button}">
            <Setter Property="Background" Value="#3D5754"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="Red"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}">
                            <ScrollViewer x:Name="PART_ContentHost" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <!-- Сбрасываем стандартные свойства обводки -->
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="Gray" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        </Style>
    </Window.Resources>

    <Window.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#000000" Offset="0" />
            <GradientStop Color="#000000" Offset="1" />
        </LinearGradientBrush>
    </Window.Background>

    <Grid>
        <Frame Content="{Binding ActivePage}" NavigationUIVisibility="Hidden"/>

        <!-- Верхнее меню -->
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="7.56*"/>
                <RowDefinition Height="92.44*"/>
            </Grid.RowDefinitions>

            <Grid  x:Name="header" MouseLeftButtonDown="DragWindow" VerticalAlignment="Stretch" 
                HorizontalAlignment="Stretch" Background="#4E4E4E">

                <!--Надпись ProjectMS-->
                <Grid HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.875*"/>
                        <ColumnDefinition Width="9.75*"/>
                        <ColumnDefinition Width="88.375*"/>
                    </Grid.ColumnDefinitions>

                    <Viewbox Grid.Column="1" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                        <TextBlock 
                        Text="ProjectMS"
                        Foreground="#FFFFFF"
                        FontFamily="Inter"
                        FontWeight="Regular"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        TextAlignment="Center"/>
                    </Viewbox>
                </Grid>


                <!--Зона поиска-->
                <Grid VerticalAlignment="Center" HorizontalAlignment="Center">
                    <Grid Width="587px" Height="42px">
                        <Border CornerRadius="10" Width="587px" Height="42px" Background="#2E2E2E">
                            <TextBox Margin="5,0,0,0" HorizontalAlignment="Left" Width="521px" Height="42px"
                                 Background="#2E2E2E" BorderBrush="Transparent" FocusVisualStyle="{x:Null}"
                                 FontSize="24px" Foreground="#FFFFFF" FontFamily="Inter" FontWeight="Regular"
                                 VerticalContentAlignment="Center"/>
                        </Border>
                        <Button Background="Transparent"
                            HorizontalAlignment="Right"
                            Style="{StaticResource ResourceKey=CloseButton}">
                            <Image x:Name="find" Source="..\Source\magnifier.png">
                                <Image.Style>
                                    <Style TargetType="{x:Type Image}">
                                        <Setter Property="Opacity" Value="1" />
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Opacity" Value="0.5" />
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Image.Style>
                            </Image>
                        </Button>
                    </Grid>
                </Grid>

                <!-- Кнопка закрытия -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="96.6875*"/>
                        <ColumnDefinition Width="2.1875*"/>
                        <ColumnDefinition Width="1.125*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="23.53*"/>
                        <RowDefinition Height="51.47*"/>
                        <RowDefinition Height="25*"/>
                    </Grid.RowDefinitions>

                    <Button Grid.Column="1" Grid.Row="1"
                        Command="{Binding CloseCommand}"
                        Background="Transparent"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch"
                        Style="{StaticResource ResourceKey=CloseButton}">
                        <Image x:Name="close" Source="..\Source\Close_icon.png">
                            <Image.Style>
                                <Style TargetType="{x:Type Image}">
                                    <Setter Property="Opacity" Value="1" />
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Opacity" Value="0.5" />
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Image.Style>
                        </Image>
                    </Button>
                </Grid>

                <!--Кнопка перехода в оконный режим-->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="92.5625*"/>
                        <ColumnDefinition Width="2.1875*"/>
                        <ColumnDefinition Width="5.3125*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="23.53*"/>
                        <RowDefinition Height="51.47*"/>
                        <RowDefinition Height="25*"/>
                    </Grid.RowDefinitions>

                    <Button Grid.Row="1" Grid.Column="1"
                        Command="{Binding RestoreCommand}"
                        CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}"
                        Background="Transparent"
                        BorderBrush="Transparent"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch"
                        Style="{StaticResource ResourceKey=CloseButton}">
                        <Image x:Name="windowModeSwitch" Source="..\Source\window_restore.png">
                            <Image.Style>
                                <Style TargetType="Image">
                                    <Setter Property="Opacity" Value="1"/>
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Opacity" Value="0.5"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Image.Style>
                        </Image>
                    </Button>
                </Grid>

                <!--Кнопка перехода в оконный режим-->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="88.3125*"/>
                        <ColumnDefinition Width="2.1875*"/>
                        <ColumnDefinition Width="9.5*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="23.53*"/>
                        <RowDefinition Height="51.47*"/>
                        <RowDefinition Height="25*"/>
                    </Grid.RowDefinitions>

                    <Button 
                        Command="{Binding RollCommand}"
                        CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}"
                        Grid.Column="1" Grid.Row="1"
                        VerticalAlignment="Stretch"
                        HorizontalAlignment="Stretch"
                        Background="Transparent"
                        BorderBrush="Transparent"
                        Style="{StaticResource ResourceKey=CloseButton}">

                        <Image x:Name="rollUp_window" Source="..\Source\roll_window.png">
                            <Image.Style>
                                <Style TargetType="Image">
                                    <Setter Property="Opacity" Value="1"/>
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Opacity" Value="0.5"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Image.Style>
                        </Image>
                    </Button>
                </Grid>

            </Grid>
        </Grid>

        <!-- Боковое меню -->
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="7.56*"/>
                <RowDefinition Height="92.44*"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="18.75*"/>
                <ColumnDefinition Width="81.25*"/>
            </Grid.ColumnDefinitions>

            <Grid Grid.Row="1" Background="#3F3F3F">
                
                
                <!--Кнопка домой-->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="10.23*"/>
                        <ColumnDefinition Width="39.25*"/>
                        <ColumnDefinition Width="50.52*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="5.17*"/>
                        <RowDefinition Height="4.11*"/>
                        <RowDefinition Height="90.72*"/>
                    </Grid.RowDefinitions>

                    <Button Background="Transparent"
                        BorderBrush="Transparent"
                        FocusVisualStyle="{x:Null}"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Left"
                        Grid.Row="1" Grid.Column="1">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="30.17*"/>
                                        <ColumnDefinition Width="69.83*"/>
                                    </Grid.ColumnDefinitions>
                                    <Image x:Name="ButtonImage"
                                       Source="../Source/home.png"
                                       HorizontalAlignment="Stretch"
                                       VerticalAlignment="Stretch"
                                       Margin="0,0,0,0"
                                       Grid.Column="0"/>
                                    <Viewbox Grid.Column="1" Stretch="Uniform">
                                        <TextBlock x:Name="ButtonText"
                                           Text="Home"
                                           FontSize="24"
                                           VerticalAlignment="Bottom"
                                           Foreground="White"
                                           HorizontalAlignment="Left"
                                           Margin="12,0,0,0"/>
                                    </Viewbox>
                                </Grid>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="ButtonImage" Property="Opacity" Value="0.5"/>
                                        <Setter TargetName="ButtonText" Property="Opacity" Value="0.5"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>


                <!-- Кнопка команды -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="10.23*"/>
                        <ColumnDefinition Width="41.64*"/>
                        <ColumnDefinition Width="48.13*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="11.3*"/>
                        <RowDefinition Height="4.81*"/>
                        <RowDefinition Height="83.89*"/>
                    </Grid.RowDefinitions>

                    <Button Background="Transparent"
                        BorderBrush="Transparent"
                        FocusVisualStyle="{x:Null}"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Left"
                        Grid.Row="1" Grid.Column="1">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="28.7*"/>
                                        <ColumnDefinition Width="71.3*"/>
                                    </Grid.ColumnDefinitions>
                                    <Image x:Name="ButtonImage"
                                       Source="../Source/team.png"
                                       HorizontalAlignment="Stretch"
                                       VerticalAlignment="Stretch"
                                       Margin="0,0,0,0"
                                       Grid.Column="0"/>
                                    <Viewbox Grid.Column="1" Stretch="Uniform">
                                        <TextBlock x:Name="ButtonText"
                                           Text="Teams"
                                           FontSize="24"
                                           VerticalAlignment="Bottom"
                                           Foreground="White"
                                           HorizontalAlignment="Left"
                                           Margin="11,0,0,0"/>
                                    </Viewbox>
                                </Grid>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="ButtonImage" Property="Opacity" Value="0.5"/>
                                        <Setter TargetName="ButtonText" Property="Opacity" Value="0.5"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>

                <!-- Кнопка календарь -->
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="17.43*"/>
                        <RowDefinition Height="4.2*"/>
                        <RowDefinition Height="78.37*"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="10.23*"/>
                        <ColumnDefinition Width="51.2*"/>
                        <ColumnDefinition Width="38.57*"/>
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="1" Grid.Row="1"
                         HorizontalAlignment="Stretch"
                         VerticalAlignment="Stretch"
                         HorizontalContentAlignment="Left"
                         VerticalContentAlignment="Center"
                         Background="Transparent"
                         BorderBrush="Transparent"
                         FocusVisualStyle="{x:Null}">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Grid x:Name="ContentGrid" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="23.33*"/>
                                        <ColumnDefinition Width="76.67*"/>
                                    </Grid.ColumnDefinitions>

                                    <Image x:Name="ButtonImage"
                                        Source="../Source/calendar.png"
                                        VerticalAlignment="Stretch"
                                        HorizontalAlignment="Stretch"
                                        Grid.Column="0"/>

                                    <Viewbox Grid.Column="1">
                                        <TextBlock x:Name="ButtonText"
                                            VerticalAlignment="Bottom"
                                            HorizontalAlignment="Left"
                                            Foreground="White"
                                            FontSize="24"
                                            Margin="11,0,0,0"
                                            Text="Calendar"/>
                                    </Viewbox>
                                </Grid>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="ButtonImage" Property="Opacity" Value="0.5"/>
                                        <Setter TargetName="ButtonText" Property="Opacity" Value="0.5"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>

                <!-- Кнопка проекты -->
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="38.46*"/>
                        <RowDefinition Height="4.11*"/>
                        <RowDefinition Height="57.43*"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="10.23*"/>
                        <ColumnDefinition Width="61.1*"/>
                        <ColumnDefinition Width="28.67*"/>
                    </Grid.ColumnDefinitions>

                    <ToggleButton Grid.Column="1" Grid.Row="1"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch"
                          HorizontalContentAlignment="Left"
                          VerticalContentAlignment="Center"
                          Background="Transparent"
                          BorderBrush="Transparent"
                          FocusVisualStyle="{x:Null}">
                        <ToggleButton.Template>
                            <ControlTemplate TargetType="ToggleButton">
                                <Grid x:Name="ContentGrid" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="19.55*"/>
                                        <ColumnDefinition Width="52*"/>
                                        <ColumnDefinition Width="28.45*"/>
                                    </Grid.ColumnDefinitions>

                                    <Image x:Name="ButtonImage"
                                       Source="../Source/folder.png"
                                       VerticalAlignment="Stretch"
                                       HorizontalAlignment="Stretch"/>

                                    <Viewbox Grid.Column="1">
                                        <TextBlock x:Name="ButtonText"
                                           VerticalAlignment="Bottom"
                                           HorizontalAlignment="Left"
                                           Foreground="White"
                                           FontSize="24"
                                           Margin="12,0,0,0"
                                           Text="Projects"/>
                                    </Viewbox>
                                    
                                    <Image x:Name="Arrow"
                                       Grid.Column="2"
                                       Source="../Source/right_arrow.png"
                                       VerticalAlignment="Stretch"
                                       HorizontalAlignment="Stretch"
                                       Margin="5,0,0,0"/>
                                </Grid>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="ButtonImage" Property="Opacity" Value="0.5"/>
                                        <Setter TargetName="ButtonText" Property="Opacity" Value="0.5"/>
                                        <Setter TargetName="Arrow" Property="Opacity" Value="0.5"/>
                                    </Trigger>
                                    <Trigger Property="IsChecked" Value="True">
                                        <Setter TargetName="Arrow" Property="Source" Value="../Source/down_arrow.png"/>
                                    </Trigger>
                                    <Trigger Property="IsChecked" Value="False">
                                        <Setter TargetName="Arrow" Property="Source" Value="../Source/right_arrow.png"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </ToggleButton.Template>
                    </ToggleButton>
                </Grid>

                <!-- Кнопка профиль -->
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="90.02*"/>
                        <RowDefinition Height="7.81*"/>
                        <RowDefinition Height="2.17*"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="4.44*"/>
                        <ColumnDefinition Width="58.7*"/>
                        <ColumnDefinition Width="36.86*"/>
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="1" Grid.Row="1"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch"
                        Background="Transparent"
                        BorderBrush="Transparent"
                        FocusVisualStyle="{x:Null}">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Grid x:Name="ContentGrid" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="37.79*"/>
                                            <ColumnDefinition Width="62.21*"/>
                                        </Grid.ColumnDefinitions>

                                        <Image x:Name="ButtonImage"
                                           Source="../Source/profile.png"
                                           VerticalAlignment="Stretch"
                                           HorizontalAlignment="Stretch"/>

                                        <Viewbox Grid.Column="1"
                                            VerticalAlignment="Center"
                                            HorizontalAlignment="Center"
                                            Margin="10,0,0,0"
                                            Stretch="Uniform">
                                            <TextBlock x:Name="ButtonText"
                                               Foreground="White"
                                               FontSize="32"
                                               Text="Profile"/>
                                        </Viewbox>
                                    </Grid>
                                </Grid>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="ButtonImage" Property="Opacity" Value="0.5"/>
                                        <Setter TargetName="ButtonText" Property="Opacity" Value="0.5"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>

                <!-- Кнопка календарь -->
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="91.58*"/>
                        <RowDefinition Height="4.81*"/>
                        <RowDefinition Height="3.61*"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="77.13*"/>
                        <ColumnDefinition Width="13.7*"/>
                        <ColumnDefinition Width="9.17*"/>
                    </Grid.ColumnDefinitions>
                    
                    <Button Grid.Column="1" Grid.Row="1"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch"
                        Background="Transparent"
                        BorderBrush="Transparent"
                        FocusVisualStyle="{x:Null}">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Viewbox Stretch="Uniform">
                                    <Image x:Name="ButtonImage" 
                                        Source="../Source/settings.png"
                                        VerticalAlignment="Stretch"
                                        HorizontalAlignment="Stretch"
                                        Margin="0,0,5,0"/>
                                </Viewbox>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="ButtonImage" Property="Opacity" Value="0.5"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>

            </Grid>
        </Grid>
    </Grid>
</Window>
