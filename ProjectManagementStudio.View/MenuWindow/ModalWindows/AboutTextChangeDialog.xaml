<Window x:Class="ProjectManagementStudio.View.MenuWindow.ModalWindows.AboutTextChangeDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ProjectManagementStudio.View.MenuWindow.ModalWindows"
        xmlns:vm="clr-namespace:ProjectManagementStudio.ViewModel.MenuWindow.ModalWindows.AboutText;assembly=ProjectManagementStudio.ViewModel"
        mc:Ignorable="d"
        Title="AboutTextChangeDialog" Height="310" Width="560"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        WindowStartupLocation="CenterScreen"
        d:DataContext="{d:DesignInstance vm:ChangeAboutTextModalWindowViewModel}">

    <Window.Resources>
        <!-- Полностью переопределяем шаблон TextBox -->
        <Style TargetType="TextBox">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ScrollViewer x:Name="PART_ContentHost" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <!-- Сбрасываем стандартные свойства обводки -->
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="Gray" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        </Style>
    </Window.Resources>

    <Border Height="300" Width="550" CornerRadius="25" Background="#2C1B47">
        <Border.Effect>
            <DropShadowEffect Color="Black" BlurRadius="15" ShadowDepth="0" Opacity="0.5"/>
        </Border.Effect>

        <Grid Background="Transparent">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="1*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock
            Margin="0,10,0,0"
            FontFamily="Outfit"
            Foreground="#FFFFFF"
            FontSize="35"
            FontWeight="Normal"
            Text="Change info"
            VerticalAlignment="Top"
            HorizontalAlignment="Center"
            />

            <Border Margin="0,67,0,0"
                    Height="155" Width="410" CornerRadius="10"
                    Background="#724D9D">
                <TextBox  Background="#724D9D"
                      BorderBrush="Transparent"
                      FontFamily="Outfit"
                      FontSize="14"
                      Foreground="#FFFFFF"
                      Text="{Binding AboutText}"
                      Margin="10"/>
            </Border>


            <StackPanel
            Grid.Row="2"
            Orientation="Horizontal"
            HorizontalAlignment="Center">

                <Button 
                Command="{Binding ChangeAboutTextCommand}"
                FontFamily="outfit"
                Foreground="#FFFFFF"
                FontSize="25"
                FontWeight="Normal">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="border" Width="191" Height="39" VerticalAlignment="Bottom"
                                    Background="#724D9D" CornerRadius="10" Margin="0,0,14,24" >
                                <ContentPresenter Content="Apply"
                                    VerticalAlignment="Center"
                                    HorizontalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="border" Property="Background" Value="#482f66"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <Button
                    FontFamily="outfit"
                    Foreground="#FFFFFF"
                    FontSize="25"
                    FontWeight="Normal"
                    Command="{Binding CloseCommand}">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="border" Width="191" Height="39" Margin="14,0,0,24" 
                                Background="#724D9D" CornerRadius="10" VerticalAlignment="Bottom">
                                <ContentPresenter Content="Cancel"
                                    VerticalAlignment="Center"
                                    HorizontalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="border" Property="Background" Value="#482f66"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

            </StackPanel>
        </Grid>
    </Border>
</Window>
    
