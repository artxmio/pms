<Window x:Class="ProjectManagementStudio.View.MenuWindow.ModalWindows.LoginChangeDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ProjectManagementStudio.View.MenuWindow.ModalWindows"
        xmlns:vm="clr-namespace:ProjectManagementStudio.ViewModel.MenuWindow.ModalWindows.NewLogin;assembly=ProjectManagementStudio.ViewModel"
        xmlns:validations="clr-namespace:ProjectManagementStudio.ViewModel.ValidationsRules;assembly=ProjectManagementStudio.ViewModel"
        xmlns:uc="clr-namespace:ProjectManagementStudio.View.UserControls.TextPasswordBox"
        mc:Ignorable="d"
        Title="LoginChangeDialog" Height="310" Width="560"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        WindowStartupLocation="CenterScreen"
        d:DataContext="{d:DesignInstance vm:ChangeLoginModalWindowViewModel}">

    <Window.Resources>
        <!-- Полностью переопределяем шаблон TextBox -->
        <Style TargetType="TextBox">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}">
                            <ScrollViewer x:Name="PART_ContentHost" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <!-- Сбрасываем стандартные свойства обводки -->
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="Gray" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        </Style>
    </Window.Resources>

    <Border Width="550" Height="300" d:Background="#2C1B47" Background="{DynamicResource MainDialogColor}" CornerRadius="25">
        <Border.Effect>
            <DropShadowEffect Color="Black" BlurRadius="15" ShadowDepth="0" Opacity="0.5"/>
        </Border.Effect>
        
        <Grid>

            <TextBlock d:Text="Change login" 
                Margin="0,9,0,0" Text="{DynamicResource ChangeLoginDialogTitle}"
                VerticalAlignment="Top" HorizontalAlignment="Center"
                FontFamily="Outfit" FontSize="35"
                Foreground="#FFFFFF" FontWeight="Normal"/>

            <TextBlock FontFamily="Outfit" FontSize="20"
                VerticalAlignment="Top" HorizontalAlignment="Left"
                Foreground="#FFFFFF" FontWeight="Normal"
                Text="{DynamicResource NewLogin}"
                d:Text="Enter a new login"
                Margin="73,50,0,0"
                Width="200" Height="25"
                />

            <Border BorderThickness="2" BorderBrush="{DynamicResource Border}" Width="410" Height="30" CornerRadius="10" d:Background="#724D9D" Background="{DynamicResource SecondDialogColor}"
                VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,81,0,0">
                <TextBox
                    VerticalContentAlignment="Center"
                    Width="400" Height="25"
                    d:Background="#724D9D" 
                    Background="{DynamicResource SecondDialogColor}"
                    BorderBrush="Transparent"
                    FontFamily="Outfit"
                    FontSize="14"
                    Foreground="#FFFFFF">
                    <TextBox.Text>
                        <Binding Path="NewLogin" UpdateSourceTrigger="PropertyChanged" Mode="TwoWay">
                            <Binding.ValidationRules>
                                <validations:LoginValidationRules ValidationStep="ConvertedProposedValue"/>
                            </Binding.ValidationRules>
                        </Binding>
                    </TextBox.Text>
                </TextBox>
            </Border>

            <TextBlock d:Text="Enter your password"
                Text="{DynamicResource Password}"
                Width="200" Height="25"
                FontFamily="Outfit" FontSize="20"
                Foreground="#FFFFFF" FontWeight="Normal"
                HorizontalAlignment="Left"
                Margin="73,0,0,0"
                />

            <Border Width="410" Height="30" d:Background="#724D9D" Background="{DynamicResource SecondDialogColor}" CornerRadius="10"
                    Margin="0,66,0,0" BorderThickness="2" BorderBrush="{DynamicResource Border}">
                <uc:TextPasswordBox
                    x:Name="password"
                    Text="{Binding Password, Mode=OneWay}"
                    VerticalContentAlignment="Center"
                    Width="400" Height="25"
                    d:Background="#724D9D" 
                    Background="{DynamicResource SecondDialogColor}"
                    BorderBrush="Transparent"
                    FontFamily="Outfit"
                    FontSize="14"
                    Foreground="#FFFFFF">   

                    <uc:TextPasswordBox.Password>
                        <Binding Path="Password" UpdateSourceTrigger="PropertyChanged" Mode="TwoWay">
                            <Binding.ValidationRules>
                                <validations:PasswordValidationRules ValidationStep="ConvertedProposedValue"/>
                            </Binding.ValidationRules>
                        </Binding>
                    </uc:TextPasswordBox.Password>

                </uc:TextPasswordBox>
            </Border>

            <Button Width="25"
                Height="25"
                Background="Transparent"
                BorderBrush="Transparent"
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
                Cursor="Hand"
                Tag="0"
                Margin="0,66,75,0"
                Click="ShowPassword">

                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </ControlTemplate>
                </Button.Template>

                <Button.Content>
                    <Image Width="25" Height="25">
                        <Image.Style>
                            <Style TargetType="Image">
                                <Setter Property="Source" d:Value="..\..\Source\DefaultTheme\eye.png" Value="{DynamicResource Eye}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource AncestorType=Button}}" Value="1">
                                        <Setter Property="Source" d:Value="..\..\Source\DefaultTheme\eye_closed.png" Value="{DynamicResource EyeClosed}"/>
                                    </DataTrigger>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Opacity" Value="0.7"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Image.Style>
                    </Image>
                </Button.Content>
            </Button>

            <Button 
                Command="{Binding CangeLoginCommand}"
                HorizontalAlignment="Left"
                Margin="70,0,0,24"
                VerticalAlignment="Bottom"
                FontFamily="outfit"
                Foreground="#FFFFFF"
                FontSize="25"
                FontWeight="Normal"
                Width="191" Height="39">
                <Button.Template>
                    <ControlTemplate>
                        <Border x:Name="border"  Width="191" Height="39"
                            d:Background="#724D9D" Background="{DynamicResource SecondDialogColor}" CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center" 
                                VerticalAlignment="Center" 
                                d:Content="Apply" Content="{DynamicResource Apply}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" d:Value="#482f66" Value="{DynamicResource ButtonHoverDialog}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>

            <Button 
                Command="{Binding CloseCommand}"
                HorizontalAlignment="Right"
                Margin="0,0,70,24"
                VerticalAlignment="Bottom"
                FontFamily="outfit"
                Foreground="#FFFFFF"
                FontSize="25"
                FontWeight="Normal"
                Width="191" Height="39">
                <Button.Template>
                    <ControlTemplate>
                        <Border x:Name="border"  Width="191" Height="39"
                            d:Background="#724D9D" Background="{DynamicResource SecondDialogColor}" CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center" 
                                VerticalAlignment="Center" 
                                d:Content="Cancel" Content="{DynamicResource Cancel}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" d:Value="#482f66" Value="{DynamicResource ButtonHoverDialog}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>
            
        </Grid>
    </Border>
</Window>
