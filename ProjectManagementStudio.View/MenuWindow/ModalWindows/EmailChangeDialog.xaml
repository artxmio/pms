<Window x:Class="ProjectManagementStudio.View.MenuWindow.ModalWindows.EmailChangeDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ProjectManagementStudio.View.MenuWindow.ModalWindows"
        xmlns:vm="clr-namespace:ProjectManagementStudio.ViewModel.MenuWindow.ModalWindows.NewEmail;assembly=ProjectManagementStudio.ViewModel"
        xmlns:validations="clr-namespace:ProjectManagementStudio.ViewModel.ValidationsRules;assembly=ProjectManagementStudio.ViewModel"
        xmlns:uc="clr-namespace:ProjectManagementStudio.View.UserControls.TextPasswordBox"
        mc:Ignorable="d"
        Title="EmailChangeDialog" Height="310" Width="560"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        WindowStartupLocation="CenterScreen"
        d:DataContext="{d:DesignInstance vm:ChangeEmailModalWindowViewModel}">

    <Window.Resources>
        <!-- Полностью переопределяем шаблон TextBox -->
        <Style TargetType="TextBox">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}">
                            <ScrollViewer x:Name="PART_ContentHost" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <!-- Сбрасываем стандартные свойства обводки -->
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="Gray" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        </Style>
    </Window.Resources>

    <Border Height="300" Width="550" CornerRadius="25" d:Background="#2C1B47" Background="{DynamicResource MainDialogColor}">
        <Border.Effect>
            <DropShadowEffect Color="Black" BlurRadius="15" ShadowDepth="0" Opacity="0.5"/>
        </Border.Effect>

        <Grid>
            <TextBlock d:Text="Change email"
                Text="{DynamicResource ChangeEmailDialogTitle}"
                Width="260" Height="44" 
                FontFamily="Outfit" FontSize="35"
                FontWeight="Normal" Foreground="#FFFFFF"
                Margin="0,10,0,0" VerticalAlignment="Top" TextAlignment="Center"/>
            
            <TextBlock d:Text="Enter a new email"
                 Text="{DynamicResource NewEmail}"
                 Width="200" Height="25"
                 FontFamily="Outfit" FontSize="20"
                 FontWeight="Normal" Foreground="#FFFFFF"
                 Margin="70,53,0,0"
                 VerticalAlignment="Top" HorizontalAlignment="Left"/>

            <Border Width="410" Height="30" d:Background="#724D9D" Background="{DynamicResource SecondDialogColor}" CornerRadius="10"
                VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,81,0,0">
                <TextBox
                    VerticalContentAlignment="Center"
                    Width="400" Height="25"
                    d:Background="#724D9D" 
                    Background="{DynamicResource SecondDialogColor}"
                    BorderBrush="Transparent"
                    FontFamily="Outfit"
                    FontSize="14"
                    Foreground="#FFFFFF">

                    <TextBox.Text>
                        <Binding Path="NewEmail" UpdateSourceTrigger="PropertyChanged" Mode="TwoWay">
                            <Binding.ValidationRules>
                                <validations:EmailValidationRules ValidationStep="ConvertedProposedValue"/>
                            </Binding.ValidationRules>
                        </Binding>
                    </TextBox.Text>

                </TextBox>
            </Border>

            <TextBlock d:Text="Enter your password"
                   Text="{DynamicResource Password}"
                   Width="200" Height="25"
                   FontFamily="Outfit" FontSize="20"
                   FontWeight="Normal" Foreground="#FFFFFF"
                   Margin="70,137,0,0"
                   VerticalAlignment="Top" HorizontalAlignment="Left"/>


            <Border Width="410" Height="30" d:Background="#724D9D" Background="{DynamicResource SecondDialogColor}" CornerRadius="10"
                VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,103">
                <uc:TextPasswordBox
                    x:Name="password"
                    Text="{Binding Password, Mode=OneWay}"
                    VerticalContentAlignment="Center"
                    Width="400" Height="25"
                    d:Background="#724D9D" 
                    Background="{DynamicResource SecondDialogColor}"
                    BorderBrush="Transparent"
                    FontFamily="Outfit"
                    FontSize="14"
                    Foreground="#FFFFFF">

                    <uc:TextPasswordBox.Password>
                        <Binding Path="Password" UpdateSourceTrigger="PropertyChanged" Mode="TwoWay">
                            <Binding.ValidationRules>
                                <validations:PasswordValidationRules ValidationStep="ConvertedProposedValue"/>
                            </Binding.ValidationRules>
                        </Binding>
                    </uc:TextPasswordBox.Password>

                </uc:TextPasswordBox>
            </Border>

            <Button Width="25"
                Height="25"
                Background="Transparent"
                BorderBrush="Transparent"
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
                Cursor="Hand"
                Tag="0"
                Margin="0,65,70,0"
                Click="ShowPassword">

                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </ControlTemplate>
                </Button.Template>

                <Button.Content>
                    <Image Width="25" Height="25">
                        <Image.Style>
                            <Style TargetType="Image">
                                <Setter Property="Source" Value="..\..\Source\eye.png"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource AncestorType=Button}}" Value="1">
                                        <Setter Property="Source" Value="..\..\Source\eye_closed.png" />
                                    </DataTrigger>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Opacity" Value="0.7"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Image.Style>
                    </Image>
                </Button.Content>
            </Button>

            <Button 
                Command="{Binding CangeEmailCommand}"
                HorizontalAlignment="Left"
                Margin="70,0,0,24"
                VerticalAlignment="Bottom"
                FontFamily="outfit"
                Foreground="#FFFFFF"
                FontSize="25"
                FontWeight="Normal"
                Width="191" Height="39">
                <Button.Template>
                    <ControlTemplate>
                        <Border x:Name="border"  Width="191" Height="39"
                            d:Background="#724D9D" Background="{DynamicResource SecondDialogColor}" CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center" 
                                VerticalAlignment="Center" 
                                d:Content="Apply" Content="{DynamicResource Apply}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" d:Value="#482f66" Value="{DynamicResource ButtonHoverDialog}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>

            <Button 
                Command="{Binding CloseCommand}"
                HorizontalAlignment="Right"
                Margin="0,0,70,24"
                VerticalAlignment="Bottom"
                FontFamily="outfit"
                Foreground="#FFFFFF"
                FontSize="25"
                FontWeight="Normal"
                Width="191" Height="39">
                <Button.Template>
                    <ControlTemplate>
                        <Border x:Name="border"  Width="191" Height="39"
                            d:Background="#724D9D" Background="{DynamicResource SecondDialogColor}" CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center" 
                                VerticalAlignment="Center" 
                                d:Content="Cancel" Content="{DynamicResource Cancel}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" d:Value="#482f66" Value="{DynamicResource ButtonHoverDialog}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>
            
        </Grid>
    </Border>
</Window>
