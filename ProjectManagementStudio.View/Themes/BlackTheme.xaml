<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Registrarion/Login -->
    <SolidColorBrush x:Key="ButtonBackground" Color="#000000"/>
    <SolidColorBrush x:Key="ButtonHover" Color="#2E2E2E"/>
    <SolidColorBrush x:Key="ButtonDisabled" Color="#4B4B4B"/>
    <SolidColorBrush x:Key="ButtonDisabledText" Color="#666666"/>
    <SolidColorBrush x:Key="Field" Color="#638F8C8D"/>
    <SolidColorBrush x:Key="RememberMeColor" Color="#000000"/>
    <BitmapImage x:Key="Background">../Source/BlackTheme/backgroundImage.png</BitmapImage>
    <BitmapImage x:Key="CloseButton">../Source/BlackTheme/Close_icon.png</BitmapImage>
    <BitmapImage x:Key="Eye">../Source/BlackTheme/eye.png</BitmapImage>
    <BitmapImage x:Key="EyeClosed">../Source/BlackTheme/eye_closed.png</BitmapImage>
    <BitmapImage x:Key="Arrow">../Source/DefaultTheme/arrow.png</BitmapImage>

    <!-- Menu Window -->
    <Style x:Key="MenuBackground" TargetType="Window">
        <Setter Property="Background">
            <Setter.Value>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="#8F8C8D" Offset="0" />
                    <GradientStop Color="#000000" Offset="1" />
                </LinearGradientBrush>
            </Setter.Value>
        </Setter>
    </Style>
    <!-- Top Menu Gradient -->
    <Color x:Key="HeaderGradientColorStart">#8F8C8D</Color>
    <Color x:Key="HeaderGradientColorEnd">#000000</Color>
    <LinearGradientBrush x:Key="HeaderBackgroundBrush" StartPoint="0,5" EndPoint="1,0">
        <GradientStop Color="{DynamicResource HeaderGradientColorStart}" Offset="0.2" />
        <GradientStop Color="{DynamicResource HeaderGradientColorEnd}" Offset="1" />
    </LinearGradientBrush>
    <!-- Left Menu Background -->
    <Color x:Key="LeftMenuGradientColorStart">#8F8C8D</Color>
    <Color x:Key="LeftMenuGradientColorEnd">#000000</Color>
    <LinearGradientBrush x:Key="LeftMenu" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="{DynamicResource LeftMenuGradientColorStart}" Offset="0.2" />
        <GradientStop Color="{DynamicResource LeftMenuGradientColorEnd}" Offset="1" />
    </LinearGradientBrush>
    <!-- Button images -->
    <BitmapImage x:Key="Home">../Source/BlackTheme/home.png</BitmapImage>
    <BitmapImage x:Key="User">../Source/BlackTheme/user.png</BitmapImage>
    <BitmapImage x:Key="Project">../Source/BlackTheme/project.png</BitmapImage>
    <BitmapImage x:Key="File">../Source/BlackTheme/file.png</BitmapImage>
    <BitmapImage x:Key="Settings">../Source/BlackTheme/settings.png</BitmapImage>
    <Style x:Key="AddProjectImageStyle" TargetType="Image">
        <Setter Property="Source" Value="../Source/BlackTheme/plus.png"/>
        <Setter Property="Opacity" Value="0.7"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Opacity" Value="1"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <BitmapImage x:Key="RollWindow">../Source/BlackTheme/roll_window.png</BitmapImage>
    <BitmapImage x:Key="CloseButtonMenu">../Source/BlackTheme/Close_icon.png</BitmapImage>
    <BitmapImage x:Key="EditInfo">../Source/BlackTheme/Edit_pencil.png</BitmapImage>


    <!-- Profile Page -->
    <SolidColorBrush x:Key="ProfileBackground">#676767</SolidColorBrush>
    <SolidColorBrush x:Key="ProfileItems">#000000</SolidColorBrush>
    <SolidColorBrush x:Key="Buttons">#FFFFFF</SolidColorBrush>
    <SolidColorBrush x:Key="ButtonsHover">#B2B2B2</SolidColorBrush>
    <SolidColorBrush x:Key="TextColor">#000000</SolidColorBrush>
    <SolidColorBrush x:Key="LogOutButtonHover">#494949</SolidColorBrush>
    <SolidColorBrush x:Key="LogOutButton">#8F8C8D</SolidColorBrush>
    <SolidColorBrush x:Key="UserProjects">#FFFFFF</SolidColorBrush>
    <SolidColorBrush x:Key="UserProjectsHover">#B2B2B2</SolidColorBrush>


    <!-- Settings -->
    <SolidColorBrush x:Key="SettingsBackground">#676767</SolidColorBrush>
    <SolidColorBrush x:Key="SettingsItems">#000000</SolidColorBrush>
    <SolidColorBrush x:Key="Button">#FFFFFF</SolidColorBrush>
    <SolidColorBrush x:Key="SettingsButtonHover">#B2B2B2</SolidColorBrush>
    <SolidColorBrush x:Key="ThemeButton">#2B2B2B</SolidColorBrush>
    <SolidColorBrush x:Key="ThemeButtonHover">#9E9E9E</SolidColorBrush>


    <!-- About Dialog -->
    <!-- Add Project Dialog -->
    <!-- Login Change Dialog -->
    <!-- Password Change Dialog -->
    <!-- Email Change Dialog -->
    <SolidColorBrush x:Key="MainDialogColor">#000000</SolidColorBrush>
    <SolidColorBrush x:Key="SecondDialogColor">#515151</SolidColorBrush>
    <SolidColorBrush x:Key="ButtonDialog">#FFFFFF</SolidColorBrush>
    <SolidColorBrush x:Key="ButtonHoverDialog">#B2B2B2</SolidColorBrush>
    <SolidColorBrush x:Key="Border">#000000</SolidColorBrush>

</ResourceDictionary>