<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Registrarion/Login -->
    <SolidColorBrush x:Key="ButtonBackground" Color="#8B3C46"/>
    <SolidColorBrush x:Key="ButtonHover" Color="#703139"/>
    <SolidColorBrush x:Key="ButtonDisabled" Color="#54242a"/>
    <SolidColorBrush x:Key="ButtonDisabledText" Color="#949494"/>
    <SolidColorBrush x:Key="Field" Color="#50E7C0BC"/>
    <SolidColorBrush x:Key="RememberMeColor" Color="#8B3C46"/>
    <BitmapImage x:Key="Background">../Source/RedTheme/backgroundImage.png</BitmapImage>
    <BitmapImage x:Key="CloseButton">../Source/RedTheme/Close_icon.png</BitmapImage>
    <BitmapImage x:Key="Eye">../Source/RedTheme/eye.png</BitmapImage>
    <BitmapImage x:Key="EyeClosed">../Source/RedTheme/eye_closed.png</BitmapImage>
    <BitmapImage x:Key="Arrow">../Source/DefaultTheme/arrow.png</BitmapImage>

    <!-- Menu Window -->
    <Style x:Key="MenuBackground" TargetType="Window">
        <Setter Property="Background">
            <Setter.Value>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="#FCC8D0" Offset="0" />
                    <GradientStop Color="#370808" Offset="1" />
                </LinearGradientBrush>
            </Setter.Value>
        </Setter>
    </Style>
    <!-- Top Menu Gradient -->
    <Color x:Key="HeaderGradientColorStart">#8B3C46</Color>
    <Color x:Key="HeaderGradientColorEnd">#370808</Color>
    <LinearGradientBrush x:Key="HeaderBackgroundBrush" StartPoint="0,5" EndPoint="1,0">
        <GradientStop Color="{DynamicResource HeaderGradientColorStart}" Offset="0.2" />
        <GradientStop Color="{DynamicResource HeaderGradientColorEnd}" Offset="1" />
    </LinearGradientBrush>
    <!-- Left Menu Background -->
    <Color x:Key="LeftMenuGradientColorStart">#8B3C46</Color>
    <Color x:Key="LeftMenuGradientColorEnd">#370808</Color>
    <LinearGradientBrush x:Key="LeftMenu" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="{DynamicResource LeftMenuGradientColorStart}" Offset="0.2" />
        <GradientStop Color="{DynamicResource LeftMenuGradientColorEnd}" Offset="1" />
    </LinearGradientBrush>
    <!-- Button images -->
    <BitmapImage x:Key="Home">../Source/RedTheme/home.png</BitmapImage>
    <BitmapImage x:Key="User">../Source/RedTheme/user.png</BitmapImage>
    <BitmapImage x:Key="Project">../Source/RedTheme/project.png</BitmapImage>
    <BitmapImage x:Key="File">../Source/RedTheme/file.png</BitmapImage>
    <BitmapImage x:Key="Settings">../Source/RedTheme/settings.png</BitmapImage>
    <Style x:Key="AddProjectImageStyle" TargetType="Image">
        <Setter Property="Source" Value="../Source/RedTheme/plus.png"/>
        <Setter Property="Opacity" Value="0.7"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Opacity" Value="1"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <BitmapImage x:Key="RollWindow">../Source/RedTheme/roll_window.png</BitmapImage>
    <BitmapImage x:Key="CloseButtonMenu">../Source/RedTheme/Close_icon.png</BitmapImage>
    <BitmapImage x:Key="EditInfo">../Source/RedTheme/Edit_pencil.png</BitmapImage>


    <!-- Profile Page -->
    <SolidColorBrush x:Key="ProfileBackground">#D27A86</SolidColorBrush>
    <SolidColorBrush x:Key="ProfileItems">#8B3C46</SolidColorBrush>
    <SolidColorBrush x:Key="Buttons">#E7C0BC</SolidColorBrush>
    <SolidColorBrush x:Key="ButtonsHover">#d1ada9</SolidColorBrush>
    <SolidColorBrush x:Key="TextColor">#370808</SolidColorBrush>
    <SolidColorBrush x:Key="LogOutButtonHover">#703038</SolidColorBrush>
    <SolidColorBrush x:Key="LogOutButton">#8B3C46</SolidColorBrush>
    <SolidColorBrush x:Key="UserProjects">#E7C0BC</SolidColorBrush>
    <SolidColorBrush x:Key="UserProjectsHover">#d1ada9</SolidColorBrush>


    <!-- Settings -->
    <SolidColorBrush x:Key="SettingsBackground">#D27A86</SolidColorBrush>
    <SolidColorBrush x:Key="SettingsItems">#8B3C46</SolidColorBrush>
    <SolidColorBrush x:Key="Button">#E7C0BC</SolidColorBrush>
    <SolidColorBrush x:Key="SettingsButtonHover">#bfa09d</SolidColorBrush>
    <SolidColorBrush x:Key="ThemeButton">#8B3C46</SolidColorBrush>
    <SolidColorBrush x:Key="ThemeButtonHover">#E7C0BC</SolidColorBrush>


    <!-- About Dialog -->
    <!-- Add Project Dialog -->
    <!-- Login Change Dialog -->
    <!-- Password Change Dialog -->
    <!-- Email Change Dialog -->
    <SolidColorBrush x:Key="MainDialogColor">#8B3C46</SolidColorBrush>
    <SolidColorBrush x:Key="SecondDialogColor">#BE6D78</SolidColorBrush>
    <SolidColorBrush x:Key="ButtonDialog">#D97E8A</SolidColorBrush>
    <SolidColorBrush x:Key="ButtonHoverDialog">#c2707b</SolidColorBrush>
    <SolidColorBrush x:Key="Border">#370808</SolidColorBrush>

</ResourceDictionary>