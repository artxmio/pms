<Window 
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        x:Class="ProjectManagementStudio.View.MainWindow.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ProjectManagementStudio.View.MainWindow"
        mc:Ignorable="d"
        Title="MainWindow" Height="900" Width="1600"
        ResizeMode="NoResize"
        WindowStyle="None"
        WindowState="Maximized"
        >
    <Window.Background>
        <ImageBrush ImageSource="Source\backgroundImage.jpg"/>
    </Window.Background>

    <Grid>
        <Frame x:Name="RegistrationFrame" NavigationUIVisibility="Hidden"/>
        <Image MouseDown="Image_MouseDown" Margin="0,20,20,0" Width="30" Height="30" HorizontalAlignment="Right" VerticalAlignment="Top" Source="Source\Close_icon2.png">
            <Image.Style>
                <Style TargetType="Image">
                    <Setter Property="Opacity" Value="0.5"/>
                    <Style.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Opacity" Value="1"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </Image.Style>
        </Image>
    </Grid>
</Window>
