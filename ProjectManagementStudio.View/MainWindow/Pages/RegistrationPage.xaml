<Page x:Class="ProjectManagementStudio.View.MainWindow.Pages.RegistrationPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
      xmlns:validations="clr-namespace:ProjectManagementStudio.ViewModel.ValidationsRules;assembly=ProjectManagementStudio.ViewModel"
      xmlns:vm="clr-namespace:ProjectManagementStudio.ViewModel.MainWindow;assembly=ProjectManagementStudio.ViewModel"
      xmlns:uc="clr-namespace:ProjectManagementStudio.View.UserControls.TextPasswordBox"
      mc:Ignorable="d" 
      d:DesignHeight="900" d:DesignWidth="1600"
      Title="RegistrationPage"
      d:DataContext="{d:DesignInstance vm:MainWindowViewModel}" 
      >
    <Page.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <materialDesign:BundledTheme BaseTheme="Light" 
                    PrimaryColor="DeepPurple" 
                    SecondaryColor="Pink" />

                <ResourceDictionary 
                    Source="pack://application:,,,/MaterialDesignThemes.Wpf;component/Themes/MaterialDesign3.Defaults.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Page.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="15.6*"/>
            <ColumnDefinition Width="27.8*"/>
            <ColumnDefinition Width="56.6*"/>
        </Grid.ColumnDefinitions>
        <Border Grid.Column="1" CornerRadius="30" Width="auto" Height="500" 
            HorizontalAlignment="Stretch" 
            VerticalAlignment="Center" 
            Background="#80DBCBE8">
            <StackPanel>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="32.2*"/>
                        <RowDefinition Height="36*"/>
                        <RowDefinition Height="31.8*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="{DynamicResource RegistrationTitle}"
                        Grid.Row="0"
                        Height="auto"
                        FontSize="65"
                        Foreground="White"
                        FontWeight="SemiBold"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Top"
                        FontFamily="Outfit"
                        Margin="0,32,0,50"
                        Padding="0,0,0,0"/>

                    <StackPanel Grid.Row="1">
                        <TextBox MaxLength="20" FontSize="20" Foreground="White" Height="auto" Width="365"
                            materialDesign:HintAssist.Hint="{DynamicResource LoginTextBox}"
                            Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                            HorizontalAlignment="Center" Margin="0,0,0,0" 
                            BorderBrush="White" FontWeight="Normal" FontFamily="Outfit">
                            <TextBox.Text>
                                <Binding Path="RegistrationModel.Login" UpdateSourceTrigger="PropertyChanged">
                                    <Binding.ValidationRules>
                                        <validations:LoginValidationRules ValidationStep="ConvertedProposedValue"/>
                                    </Binding.ValidationRules>
                                </Binding>
                            </TextBox.Text>
                        </TextBox>

                        <TextBox x:Name="EmailTextBox" MaxLength="50" FontSize="20" Foreground="White" Height="auto" Width="365"
                            materialDesign:HintAssist.Hint="{DynamicResource EmailTextBox}"
                            Style="{StaticResource MaterialDesignFloatingHintTextBox}" 
                            HorizontalAlignment="Center" Margin="0,21,0,0" BorderBrush="White"
                            FontWeight="Normal" FontFamily="Outfit">
                            <TextBox.Text>
                                <Binding Path="RegistrationModel.Email" UpdateSourceTrigger="PropertyChanged">
                                    <Binding.ValidationRules>
                                        <validations:EmailValidationRules ValidationStep="ConvertedProposedValue"/>
                                    </Binding.ValidationRules>
                                </Binding>
                            </TextBox.Text>
                        </TextBox>

                        <Grid Width="365" Height="40" Margin="0,21,0,0">
                            <uc:TextPasswordBox   
                                Text="{Binding RegistrationModel.Password, Mode=OneWay}"
                                x:Name="password"
                                MaxLength="24"
                                FontSize="20"
                                Foreground="white" 
                                Height="auto" 
                                Width="365"
                                materialDesign:HintAssist.Hint="{DynamicResource PasswordTextBox}"
                                Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                                HorizontalAlignment="Left"
                                Margin="0,0,0,0"
                                BorderBrush="white"
                                FontWeight="Normal" FontFamily="Outfit">

                                <uc:TextPasswordBox.Password>
                                    <Binding Path="RegistrationModel.Password" UpdateSourceTrigger="PropertyChanged" NotifyOnTargetUpdated="True">
                                        <Binding.ValidationRules>
                                            <validations:PasswordValidationRules ValidationStep="ConvertedProposedValue"/>
                                        </Binding.ValidationRules>
                                    </Binding>
                                </uc:TextPasswordBox.Password>
                            </uc:TextPasswordBox>
                        
                            <Button Width="25"
                                Height="25"
                                Background="Transparent"
                                BorderBrush="Transparent"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Cursor="Hand"
                                Tag="0"
                                Click="ShowPassword">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </ControlTemplate>
                                </Button.Template>
                                <Button.Content>
                                    <Image Width="25" Height="25">
                                        <Image.Style>
                                            <Style TargetType="Image">
                                                <Setter Property="Source" Value="..\..\Source\eye.png"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource AncestorType=Button}}" Value="1">
                                                        <Setter Property="Source" Value="..\..\Source\eye_closed.png" />
                                                    </DataTrigger>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Opacity" Value="0.7"/>
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Image.Style>
                                    </Image>
                                </Button.Content>
                            </Button>
                        </Grid>
                    </StackPanel>

                    <StackPanel Grid.Row="2">
                        <Button Background="#2C1B45"
                            FontWeight="Normal" 
                            FontFamily="Outfit" 
                            FontSize="40" 
                            Margin="0,30,0,0" 
                            Content="{DynamicResource Continue}" 
                            Width="370" 
                            Height="auto"
                            IsEnabled="{Binding RegistrationModel.IsValid}" 
                            Command="{Binding RegistrationCommand}">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="buttonBorder" 
                                        Background="{TemplateBinding Background}" 
                                        BorderBrush="{TemplateBinding BorderBrush}" 
                                        CornerRadius="30">
                                        <ContentPresenter
                                            Margin="0,5,0,5"
                                            HorizontalAlignment="Center" 
                                            VerticalAlignment="Center"/>
                                    </Border>

                                    <ControlTemplate.Triggers>
                                        <!-- Триггер для изменения цвета при наведении (когда активна) -->
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="buttonBorder" Property="Background" Value="#3B2B57"/>
                                        </Trigger>

                                        <!-- Цвет для неактивного состояния кнопки -->
                                        <Trigger Property="IsEnabled" Value="False">
                                            <Setter TargetName="buttonBorder" Property="Background" Value="#1A1230"/>
                                            <Setter Property="Foreground" Value="#666666" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <Line X1="1" Y1="0" X2="366" Y2="0" Grid.Row="2" 
                        Stroke="White" StrokeThickness="1" HorizontalAlignment="Center"
                        Margin="0,16,0,0"/>

                        <Grid Margin="0,6,0,0" HorizontalAlignment="Center" Grid.Row="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <!-- Автоматическая ширина для TextBlock -->
                                <ColumnDefinition Width="Auto"/>
                                <!-- Автоматическая ширина для Button -->
                            </Grid.ColumnDefinitions>

                            <!-- TextBlock -->
                            <TextBlock FontFamily="Outfit" FontSize="20" FontWeight="Normal"
                           Foreground="White" Text="{DynamicResource HaveAccount}"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           TextAlignment="Center" Grid.Column="0" />

                            <!-- Button -->
                            <Button Margin="5,0,0,0" VerticalAlignment="Center" HorizontalAlignment="Center" Grid.Column="1"
                                Command="{Binding NavigateToLoginPage}" Background="Transparent" BorderBrush="Transparent">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <StackPanel Orientation="Vertical" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <TextBlock x:Name="buttonText" Margin="0,0.3,0,0"
                                               Text="{DynamicResource LogInAccount}" 
                                               Foreground="#4683F5"
                                               FontSize="20"
                                               FontFamily="Outfit"
                                               FontWeight="Normal"
                                               TextAlignment="Center" />
                                            <Border x:Name="bottomBorder" Height="1" Margin="0,-4,0,0" 
                                                HorizontalAlignment="Stretch" Background="#4683F5" />
                                        </StackPanel>

                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="buttonText" Property="Foreground" Value="#8A47D3"/>
                                                <Setter TargetName="bottomBorder" Property="Background" Value="#8A47D3"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </Grid>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Border>
    </Grid>
</Page>
