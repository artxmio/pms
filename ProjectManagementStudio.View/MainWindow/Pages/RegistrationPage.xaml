<Page x:Class="ProjectManagementStudio.View.MainWindow.Pages.RegistrationPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
      xmlns:validations="clr-namespace:ProjectManagementStudio.ViewModel.ValidationsRules;assembly=ProjectManagementStudio.ViewModel"
      xmlns:vm="clr-namespace:ProjectManagementStudio.ViewModel.MainWindow;assembly=ProjectManagementStudio.ViewModel"
      mc:Ignorable="d" 
      d:DesignHeight="900" d:DesignWidth="1600"
      Title="RegistrationPage"
      d:DataContext="{d:DesignInstance vm:MainWindowViewModel}" 
      >
    <Page.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <materialDesign:BundledTheme BaseTheme="Light" 
                                         PrimaryColor="DeepPurple" 
                                         SecondaryColor="Pink" />

                <ResourceDictionary 
                Source="pack://application:,,,/MaterialDesignThemes.Wpf;component/Themes/MaterialDesign3.Defaults.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Page.Resources>

    <Border CornerRadius="30" Width="446" Height="500" 
        HorizontalAlignment="Left" 
        VerticalAlignment="Center" 
        Margin="250,0,0,0"
        Background="#80DBCBE8" 
        >
        <StackPanel>
            <TextBlock Text="Sign up"
                   Width="267"
                   Height="92"
                   FontSize="75"
                   Foreground="White"
                   FontWeight="SemiBold"
                   HorizontalAlignment="left"
                   VerticalAlignment="Center"
                   FontFamily="Outfit"
                   Margin="99,32,0,0"
                   />
            <TextBox MaxLength="20" FontSize="20" Foreground="White" Height="42" Width="365"
             materialDesign:HintAssist.Hint="login"
             Style="{StaticResource MaterialDesignFloatingHintTextBox}"
             HorizontalAlignment="Left"
             Margin="41,30,0,0"
             BorderBrush="White"
             FontWeight="Normal" FontFamily="Outfit">
                <TextBox.Text>
                    <Binding Path="RegistrationModel.Login" UpdateSourceTrigger="PropertyChanged">
                        <Binding.ValidationRules>
                            <validations:LoginValidationRules ValidationStep="ConvertedProposedValue"/>
                        </Binding.ValidationRules>
                    </Binding>
                </TextBox.Text>
            </TextBox>

            <TextBox x:Name="EmailTextBox" MaxLength="50" FontSize="20" Foreground="White" Height="42" Width="365"
             materialDesign:HintAssist.Hint="email"
             Style="{StaticResource MaterialDesignFloatingHintTextBox}"
             HorizontalAlignment="Left"
             Margin="41,21,0,0"
             BorderBrush="White"
             FontWeight="Normal" FontFamily="Outfit">
                <TextBox.Text>
                    <Binding Path="RegistrationModel.Email" UpdateSourceTrigger="PropertyChanged">
                        <Binding.ValidationRules>
                            <validations:EmailValidationRules ValidationStep="ConvertedProposedValue"/>
                        </Binding.ValidationRules>
                    </Binding>
                </TextBox.Text>
            </TextBox>

            <TextBox x:Name="PasswordTextBox" MaxLength="24" FontSize="20" Foreground="White" Height="42" Width="365"
             materialDesign:HintAssist.Hint="password"
             Style="{StaticResource MaterialDesignFloatingHintTextBox}"
             HorizontalAlignment="Left"
             Margin="41,21,0,0"
             BorderBrush="White"
             FontWeight="Normal" FontFamily="Outfit">
                <TextBox.Text>
                    <Binding Path="RegistrationModel.Password" UpdateSourceTrigger="PropertyChanged">
                        <Binding.ValidationRules>
                            <validations:PasswordValidationRules ValidationStep="ConvertedProposedValue"/>
                        </Binding.ValidationRules>
                    </Binding>
                </TextBox.Text>
            </TextBox>

            <Button Background="#2C1B45" 
                    FontWeight="Normal" 
                    FontFamily="Outfit" 
                    FontSize="40" 
                    Margin="0,44,0,0" 
                    Content="Continue" 
                    Width="370" 
                    Height="60"
                    IsEnabled="{Binding RegistrationModel.IsValid}" 
                    Command="{Binding RegistrationCommand}">

                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="buttonBorder" 
                    Background="{TemplateBinding Background}" 
                    BorderBrush="{TemplateBinding BorderBrush}" 
                    CornerRadius="30">
                            <ContentPresenter 
                    HorizontalAlignment="Center" 
                    VerticalAlignment="Center"/>
                        </Border>

                        <ControlTemplate.Triggers>
                            <!-- Триггер для изменения цвета при наведении (когда активна) -->
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="buttonBorder" Property="Background" Value="#3B2B57"/>
                            </Trigger>

                            <!-- Цвет для неактивного состояния кнопки -->
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="buttonBorder" Property="Background" Value="#1A1230"/>
                                <Setter Property="Foreground" Value="#666666" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>

            <Line X1="1" Y1="0" X2="366" Y2="0" 
                  Stroke="White" StrokeThickness="1"
                  Margin="41,16,0,0"  
            />
            <Grid Width="286" Height="28" Margin="0,6,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="231"/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <TextBlock FontFamily="Outfit" FontSize="20" FontWeight="Normal"
                            Foreground="White" Text="Already have an account?"
                />

                <Button VerticalAlignment="Top" Padding="0" Width="55" Height="28" HorizontalAlignment="Left" Grid.Column="2" Command="{Binding NavigateToLoginPage}" Background="Transparent" BorderBrush="Transparent" Margin="0,0,0,0">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <StackPanel Orientation="Vertical" Width="54" Height="28">
                                <TextBlock x:Name="buttonText" Margin="0,0.3,0,0"
                                           Text="Log in" 
                                           Foreground="#4683F5"
                                           FontSize="20"
                                           FontFamily="Outfit"
                                           FontWeight="Normal"/>
                                <Border x:Name="bottomBorder" Width="53" Height="1" Margin="0,0,0,0" HorizontalAlignment="Center" Background="#4683F5" />
                            </StackPanel>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="buttonText" Property="Foreground" Value="#8A47D3"/>
                                    <Setter TargetName="bottomBorder" Property="Background" Value="#8A47D3"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>
        </StackPanel>
    </Border>
</Page>
