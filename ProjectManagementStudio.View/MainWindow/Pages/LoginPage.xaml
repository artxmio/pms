<Page x:Class="ProjectManagementStudio.View.MainWindow.Pages.LoginPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:ProjectManagementStudio.View.MainWindow.Pages"
      xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
      xmlns:validations="clr-namespace:ProjectManagementStudio.ViewModel.ValidationsRules;assembly=ProjectManagementStudio.ViewModel"
      xmlns:vm="clr-namespace:ProjectManagementStudio.ViewModel.MainWindow;assembly=ProjectManagementStudio.ViewModel"
      
      mc:Ignorable="d" 
      d:DesignHeight="900" d:DesignWidth="1600"
      Title="LoginPage"
      d:DataContext="{d:DesignInstance vm:MainWindowViewModel}" 
      >
    <Page.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <materialDesign:BundledTheme BaseTheme="Light" 
                                     PrimaryColor="DeepPurple" 
                                     SecondaryColor="Pink" />

                <ResourceDictionary 
            Source="pack://application:,,,/MaterialDesignThemes.Wpf;component/Themes/MaterialDesign3.Defaults.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Page.Resources>

    <Border CornerRadius="30" Width="446" Height="500" 
    HorizontalAlignment="Left" 
    VerticalAlignment="Center" 
    Margin="250,0,0,0"
    Background="#80DBCBE8" 
    >
        <StackPanel>
            <TextBlock Text="Log in"
               Width="210"
               Height="92"
               FontSize="75"
               Foreground="White"
               FontWeight="SemiBold"
               HorizontalAlignment="center"
               VerticalAlignment="Center"
               FontFamily="Outfit"
               Margin="0,37,0,0"
               />
            <TextBox x:Name="login" MaxLength="20" FontSize="20" Foreground="white" Height="41" Width="365"
                 materialDesign:HintAssist.Hint="login"
                 Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                 HorizontalAlignment="Left"
                 Margin="41,42,0,0"
                 BorderBrush="white"
                 FontWeight="Normal" FontFamily="Outfit">
                <TextBox.Text>
                    <Binding Path="LoginModel.login" UpdateSourceTrigger="PropertyChanged" NotifyOnTargetUpdated="True">
                        <Binding.ValidationRules>
                            <validations:LoginValidationRules ValidationStep="ConvertedProposedValue"/>
                        </Binding.ValidationRules>
                    </Binding>
                </TextBox.Text>
            </TextBox>

            <TextBox x:Name="password" MaxLength="24" FontSize="20" Foreground="white" Height="40" Width="365"
            materialDesign:HintAssist.Hint="password"
            Style="{StaticResource MaterialDesignFloatingHintTextBox}"
            HorizontalAlignment="Left"
            Margin="41,32,0,0"
            BorderBrush="white"
            FontWeight="Normal" FontFamily="Outfit">

                <TextBox.Text>
                    <Binding Path="LoginModel.password" UpdateSourceTrigger="PropertyChanged">
                        <Binding.ValidationRules>
                            <validations:PasswordValidationRules ValidationStep="ConvertedProposedValue"/>
                        </Binding.ValidationRules>
                    </Binding>
                </TextBox.Text>

            </TextBox>

            <CheckBox Width="123" Content="remember me" Margin="40,30,0,0" BorderBrush="#2C1B45"
                      FontFamily="Outfit" FontWeight="Normal" Foreground="White"
                      FontSize="16" VerticalContentAlignment="Center"
                      VerticalAlignment="Center" HorizontalAlignment="Left"
                      IsChecked="{Binding LoginModel.IsRememberMe}"
            />
            <Button Click="LoginButton_Click" Background="#2C1B45" 
            FontWeight="Normal" 
            FontFamily="Outfit"
            FontSize="40" 
            Margin="0,30,0,0" 
            Content="Continue" 
            Width="370" 
            Height="60" 
            IsEnabled="{Binding LoginModel.IsValid}"
            Command="{Binding AuthorizationCommand}">

                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="buttonBorder" 
                    Background="{TemplateBinding Background}" 
                    BorderBrush="{TemplateBinding BorderBrush}" 
                    CornerRadius="30">
                            <ContentPresenter 
                    HorizontalAlignment="Center" 
                    VerticalAlignment="Center"/>
                        </Border>

                        <ControlTemplate.Triggers>
                            <!-- Триггер для изменения цвета при наведении (если кнопка активна) -->
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="buttonBorder" Property="Background" Value="#3B2B57"/>
                            </Trigger>

                            <!-- Цвет для неактивного состояния кнопки -->
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="buttonBorder" Property="Background" Value="#1A1230"/>
                                <Setter Property="Foreground" Value="#666666" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>
            <Line X1="1" Y1="0" X2="366" Y2="0" 
              Stroke="White" StrokeThickness="1"
              Margin="41,16,0,0"  
            />
            <Grid Width="314" Height="23" Margin="0,6,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="209"/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <TextBlock FontFamily="Outfit" FontSize="20" FontWeight="Normal"
                        Foreground="White" Text="Don't have an account?"/>

                <TextBlock Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="20" Foreground="White">
                
                    <Hyperlink NavigateUri="RegistrationPage.xaml" Foreground="#2883F8" RequestNavigate="Hyperlink_RequestNavigate">
                    Create new
               
                    </Hyperlink>
                </TextBlock>
            </Grid>
        </StackPanel>
    </Border>
</Page>
